+
 INT32 avc444_decompress(H264_CONTEXT* h264, BYTE op, const RECTANGLE_16* regionRects,
                         UINT32 numRegionRects, const BYTE* pSrcData, UINT32 SrcSize,
                         const RECTANGLE_16* auxRegionRects, UINT32 numAuxRegionRect,
@@ -772,6 +807,43 @@ INT32 avc444_decompress(H264_CONTEXT* h264, BYTE op, const RECTANGLE_16* regionR
 		ycn_h264_diag_frame_failure(h264, -1013, "avc444-region-main");
 		return -1013;
 	}
+
+	/* Yomori low chroma mode: the auxiliary stream is not consumed, so its
+	 * rectangles are neither validated nor applied. */
+	if (h264->ycnAvc444LowChroma != 0)
+	{
+		BOOL decoded = FALSE;
+
+		switch (op)
+		{
+			case 0: /* main luma + chroma420, aux chroma ignored */
+			case 1: /* main luma update */
+				decoded = ycn_avc444_low_chroma_rects(h264, pSrcData, SrcSize, pDstData,
+				                                      DstFormat, nDstStep, regionRects,
+				                                      numRegionRects, FALSE);
+				break;
+			case 2: /* chroma-only update in the main stream */
+				decoded = ycn_avc444_low_chroma_rects(h264, pSrcData, SrcSize, pDstData,
+				                                      DstFormat, nDstStep, regionRects,
+				                                      numRegionRects, TRUE);
+				break;
+			default:
+				break;
+		}
+
+		if (!decoded)
+		{
+			ycn_h264_diag_frame_failure(h264, -1017, "avc444-low-chroma");
+			return -1017;
+		}
+
+		/* 与上游 avc444_decompress 的成功返回保持一致：成功是 0，只有负值才
+		 * 表示失败（gfx.c 只判 rc < 0）。这里返回正数会让按上游契约写的
+		 * 调用方/测试把成功当异常。 */
+		ycn_h264_diag_frame_success(h264);
+		return 0;
+	}
+
 	if (!areRectsValid(h264->log, nDstWidth, nDstHeight, auxRegionRects, numAuxRegionRect))
 	{
 		ycn_h264_diag_frame_failure(h264, -1014, "avc444-region-aux");
@@ -1091,6 +1163,9 @@ BOOL h264_context_set_option(H264_CONTEXT* h264, H264_CONTEXT_OPTION option, UIN
 			else if (value == YCN_H264_DECODE_POLICY_AUTO_HW)
 				h264->hwAccel = 1;
 			return TRUE;
+		case H264_CONTEXT_OPTION_YCN_AVC444_LOW_CHROMA:
+			h264->ycnAvc444LowChroma = value ? 1u : 0u;
+			return TRUE;
 		default:
 			WLog_Print(h264->log, WLOG_WARN, "Unknown H264_CONTEXT_OPTION[0x%08" PRIx32 "]",
 			           option);
@@ -1117,6 +1192,8 @@ UINT32 h264_context_get_option(H264_CONTEXT* h264, H264_CONTEXT_OPTION option)
 			return h264->hwAccel;
 		case H264_CONTEXT_OPTION_YCN_DECODE_POLICY:
 			return h264->ycnDecodePolicy;
+		case H264_CONTEXT_OPTION_YCN_AVC444_LOW_CHROMA:
+			return h264->ycnAvc444LowChroma;
 		default:
 			WLog_Print(h264->log, WLOG_WARN, "Unknown H264_CONTEXT_OPTION[0x%08" PRIx32 "]",
 			           option);
