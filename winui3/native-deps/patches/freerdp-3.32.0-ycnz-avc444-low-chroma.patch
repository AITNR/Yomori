+/* Yomori AVC444 low chroma mode.
+ *
+ * The main bitstream of an AVC444 surface command already is a complete YUV420
+ * image; the auxiliary stream only restores 4:4:4 chroma. In low chroma mode we
+ * therefore decode the main stream and convert its 4:2:0 planes straight into
+ * the destination surface -- the same primitives the AVC420 path uses -- instead
+ * of expanding to YUV444 and converting. The auxiliary stream is never submitted
+ * to the decoder.
+ *
+ * decodeOnly != 0 (op == 2, chroma-only update) still feeds the main stream to
+ * the decoder so the reference chain stays intact, but writes no pixels: the
+ * region keeps its previous colour until a later op 0/1 update covers it.
+ */
+static BOOL ycn_avc444_low_chroma_rects(H264_CONTEXT* h264, const BYTE* pSrcData, UINT32 SrcSize,
+                                       BYTE* pDstData, DWORD DstFormat, UINT32 nDstStep,
+                                       const RECTANGLE_16* rects, UINT32 nrRects, BOOL decodeOnly)
+{
+	const BYTE* pYUVData[3];
+	const INT32 status = log_decompress(h264, pSrcData, SrcSize, rects, nrRects);
+
+	if (status < 0)
+		return FALSE;
+	if (status == 0)
+		return TRUE; /* no new frame produced, nothing to present */
+	if (decodeOnly)
+		return TRUE;
+
+	pYUVData[0] = h264->pYUVData[0];
+	pYUVData[1] = h264->pYUVData[1];
+	pYUVData[2] = h264->pYUVData[2];
+	return yuv420_context_decode(h264->yuv, pYUVData, h264->iStride, h264->YUVHeight, DstFormat,
+	                             pDstData, nDstStep, rects, nrRects);
+}
