+/* ---- Yomori AVC444 low chroma mode ---------------------------------------
+ *
+ * Per-rdpContext opt-in switch consumed by gdi_SurfaceCommand_AVC444(). It is
+ * intentionally independent of the GDI/GFX structures so the default build has
+ * no behavioural change: without a registered entry the getter returns FALSE
+ * and the upstream 4:4:4 path runs unchanged.
+ */
+
+#define YCN_AVC444_SLOTS 16
+
+typedef struct
+{
+	const rdpContext* context;
+	BOOL enabled;
+} YCN_AVC444_ENTRY;
+
+static YCN_AVC444_ENTRY g_ycnAvc444[YCN_AVC444_SLOTS];
+static SRWLOCK g_ycnAvc444Lock = SRWLOCK_INIT;
+
+static YCN_AVC444_ENTRY* ycn_avc444_entry(const rdpContext* context, BOOL create)
+{
+	YCN_AVC444_ENTRY* slot = nullptr;
+	size_t i;
+
+	if (!context)
+		return nullptr;
+
+	AcquireSRWLockExclusive(&g_ycnAvc444Lock);
+	for (i = 0; i < YCN_AVC444_SLOTS; i++)
+	{
+		if (g_ycnAvc444[i].context == context)
+		{
+			slot = &g_ycnAvc444[i];
+			break;
+		}
+		if (!g_ycnAvc444[i].context && !slot)
+			slot = &g_ycnAvc444[i];
+	}
+	if (slot && !slot->context && create)
+	{
+		slot->context = context;
+		slot->enabled = FALSE;
+	}
+	if (slot && !slot->context)
+		slot = nullptr;
+	ReleaseSRWLockExclusive(&g_ycnAvc444Lock);
+	return slot;
+}
+
+FREERDP_API void ycn_gdi_set_avc444_low_chroma(rdpContext* context, BOOL enabled)
+{
+	YCN_AVC444_ENTRY* entry = ycn_avc444_entry(context, TRUE);
+
+	if (entry)
+		entry->enabled = enabled ? TRUE : FALSE;
+}
+
+FREERDP_API BOOL ycn_gdi_get_avc444_low_chroma(const rdpContext* context)
+{
+	const YCN_AVC444_ENTRY* entry = ycn_avc444_entry(context, FALSE);
+	return (entry && entry->enabled) ? TRUE : FALSE;
+}
+
+/* Called on session teardown so a recycled context pointer cannot inherit a
+ * previous session's mode. Safe to call with an unregistered context. */
+FREERDP_API void ycn_gdi_release_avc444_low_chroma(const rdpContext* context)
+{
+	YCN_AVC444_ENTRY* entry = ycn_avc444_entry(context, FALSE);
+
+	if (entry)
+	{
+		AcquireSRWLockExclusive(&g_ycnAvc444Lock);
+		entry->context = nullptr;
+		entry->enabled = FALSE;
+		ReleaseSRWLockExclusive(&g_ycnAvc444Lock);
+	}
+}
