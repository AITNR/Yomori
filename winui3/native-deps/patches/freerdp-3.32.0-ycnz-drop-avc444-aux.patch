+/* Yomori monitor mode: drop the AVC444 auxiliary stream.
+ *
+ * With op == 0 the server sends two streams: stream 1 (main) is a complete
+ * YUV420 image, stream 2 (aux) carries extra chroma that restores 4:4:4.
+ * Running AVC444_LUMA on the main stream alone already upsamples U/V to full
+ * resolution (see general_LumaToYUV444, blocks B2/B3), so the picture stays
+ * complete and only the chroma precision drops to 4:2:0 -- exactly what
+ * AVC420 delivers. Skipping the aux stream saves its H.264 decode, the
+ * per-pixel chroma rebuild, and the decoder reconfiguration caused by
+ * feeding two independent bitstreams through one decoder instance.
+ *
+ * Enabled by ycn_rdp.c through the YOMORI_AVC444_DROP_AUX environment
+ * variable (command line: --embed-drop-avc444-aux). When unset the upstream
+ * behaviour is unchanged. The result is cached; a new value needs a reconnect.
+ */
+static BOOL ycn_drop_avc444_aux_enabled(void)
+{
+	static int cached = -1;
+
+	if (cached < 0)
+	{
+		char buf[8] = { 0 };
+		const DWORD n = GetEnvironmentVariableA("YOMORI_AVC444_DROP_AUX", buf, sizeof(buf));
+		cached = ((n > 0) && (n < sizeof(buf)) && (buf[0] != '0')) ? 1 : 0;
+	}
+
+	return cached ? TRUE : FALSE;
+}
