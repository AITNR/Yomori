+/* Yomori: pause H.264 decoding while the window is invisible.
+ *
+ * When nothing on screen can show the frame (minimized, hidden, fully occluded)
+ * the whole command is dropped: no decode, no chroma work, and crucially no
+ * invalidRegion / UpdateSurfaceArea, so the presenter never wakes up either.
+ * The server keeps sending (bandwidth unchanged), but local CPU drops to almost
+ * nothing -- exactly the trade a "leave it running" monitor wants.
+ *
+ * State comes from ycn_rdp.dll via ycn_rdp_set_decode_paused(), written into
+ * this process' environment block, so winpr's process-env API sees it. Read on
+ * every frame on purpose: no caching, the flag flips at runtime.
+ */
+static BOOL ycn_decode_paused(void)
+{
+	char buf[8] = { 0 };
+	const DWORD n = GetEnvironmentVariableA("YOMORI_DECODE_PAUSED", buf, sizeof(buf));
+	return ((n > 0) && (n < sizeof(buf)) && (buf[0] != '0')) ? TRUE : FALSE;
+}
+
+/* Set while frames are being dropped; the first frame after resuming triggers a
+ * full refresh, because the P frames skipped during the pause left the H.264
+ * reference chain broken. */
+static BOOL ycn_was_paused = FALSE;
+
 static UINT gdi_SurfaceCommand_AVC444(rdpGdi* gdi, RdpgfxClientContext* context,
                                       const RDPGFX_SURFACE_COMMAND* cmd)
 {
