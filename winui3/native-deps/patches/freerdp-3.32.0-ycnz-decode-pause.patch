+/* Yomori: 不可见就整帧丢弃。
+ *
+ * 两种触发, 都在解码之前生效:
+ *   1) 进程级 -- 整个窗口不可见(最小化/收进托盘)。托管侧 ycn_rdp_set_decode_paused()
+ *      写进程环境变量 YOMORI_DECODE_PAUSED, 这里读。
+ *   2) 会话级 -- 该通道没有画面消费者(切走页面、画面被摘掉)。由 ycn_rdp.dll 的
+ *      ycn_rdp_set_session_decode_paused() 经 ycn_gdi_set_session_paused() 设置。
+ *
+ * 丢帧连 invalidRegion / UpdateSurfaceArea 都不走, 所以呈现节拍器也不会被唤醒。
+ * 服务端照旧推帧(带宽不变), 帧确认照常发送, 会话不会因为"客户端不收"而降级或断开。
+ *
+ * 恢复后必须请求一次全帧刷新, 并让解码器等到关键帧: 暂停期间丢掉的 P 帧已让
+ * 参考链断裂, 直接解下一张 P 帧会出成片错误块。
+ */
+#define YCN_PAUSE_SLOTS 16
+
+typedef struct
+{
+	const rdpContext* ctx;
+	volatile LONG paused;        /* 会话级: 没有消费者 */
+	volatile LONG needs_refresh; /* 丢过帧, 恢复后要补一帧 */
+} YCN_PAUSE_ENTRY;
+
+static YCN_PAUSE_ENTRY g_ycn_pause[YCN_PAUSE_SLOTS];
+static SRWLOCK g_ycn_pause_lock = SRWLOCK_INIT;
+
+WINPR_ATTR_UNUSED static YCN_PAUSE_ENTRY* ycn_pause_entry(const rdpContext* ctx)
+{
+	size_t i;
+	YCN_PAUSE_ENTRY* slot = nullptr;
+
+	if (!ctx)
+		return nullptr;
+
+	AcquireSRWLockExclusive(&g_ycn_pause_lock);
+	for (i = 0; i < YCN_PAUSE_SLOTS; i++)
+	{
+		if (g_ycn_pause[i].ctx == ctx)
+		{
+			slot = &g_ycn_pause[i];
+			break;
+		}
+		if (!g_ycn_pause[i].ctx && !slot)
+			slot = &g_ycn_pause[i];
+	}
+	if (slot && !slot->ctx)
+	{
+		slot->ctx = ctx;
+		InterlockedExchange(&slot->paused, 0);
+		InterlockedExchange(&slot->needs_refresh, 0);
+	}
+	ReleaseSRWLockExclusive(&g_ycn_pause_lock);
+	return slot;
+}
+
+/* 整个窗口不可见: 进程级开关, 托管侧经环境变量转达。 */
+WINPR_ATTR_UNUSED static BOOL ycn_pause_global(void)
+{
+	char buf[8] = { 0 };
+	const DWORD n = GetEnvironmentVariableA("YOMORI_DECODE_PAUSED", buf, sizeof(buf));
+	return ((n > 0) && (n < sizeof(buf)) && (buf[0] != '0')) ? TRUE : FALSE;
+}
+
+WINPR_ATTR_UNUSED static BOOL ycn_pause_should_drop(YCN_PAUSE_ENTRY* entry)
+{
+	if (ycn_pause_global())
+		return TRUE;
+	if (!entry)
+		return FALSE;
+	return (InterlockedCompareExchange(&entry->paused, 0, 0) != 0) ? TRUE : FALSE;
+}
+
+/* ycn_rdp.dll 调用: 该会话当前有没有画面消费者。 */
+FREERDP_API void ycn_gdi_set_session_paused(rdpContext* context, BOOL paused)
+{
+	YCN_PAUSE_ENTRY* entry = ycn_pause_entry(context);
+
+	if (entry)
+		InterlockedExchange(&entry->paused, paused ? 1 : 0);
+}
