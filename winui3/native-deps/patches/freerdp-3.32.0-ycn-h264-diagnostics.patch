+/* ---- Yomori direct-present surface probe ---------------------------------
+ *
+ * The decoder thread publishes a descriptor of the surface behind the last
+ * decoded frame. Nothing in here changes GDI drawing: the probe only records
+ * what the surface is, whether the frame can be mapped without a copy, and how
+ * much the GPU->CPU transfer actually cost. The bridge consumes it to decide
+ * whether a zero-copy path exists for the current session.
+ */
+
+/* Bounded: the map probe is only attempted for the first frames of a context,
+ * so the steady state pays nothing. A generation change (reset) re-arms it. */
+#define YCN_H264_SURFACE_PROBE_LIMIT 8U
+
+static ycn_h264_surface_sink g_YcnSurfaceSink = NULL;
+static void* g_YcnSurfaceSinkUser = NULL;
+
+UINT64 ycn_h264_qpc_frequency(void)
+{
+#ifdef _WIN32
+	static LONGLONG freq = 0;
+	if (freq == 0)
+	{
+		LARGE_INTEGER value = { 0 };
+		if (!QueryPerformanceFrequency(&value))
+			return 0;
+		freq = value.QuadPart;
+	}
+	return (UINT64)freq;
+#else
+	return 0;
+#endif
+}
+
+UINT32 ycn_h264_surface_api_version(void)
+{
+	return YCN_H264_SURFACE_API_VERSION;
+}
+
+void ycn_h264_set_surface_sink(ycn_h264_surface_sink sink, void* user)
+{
+	g_YcnSurfaceSink = sink;
+	g_YcnSurfaceSinkUser = user;
+}
+
+BOOL ycn_h264_surface_probe_wanted(H264_CONTEXT* h264)
+{
+	if (!h264)
+		return FALSE;
+	return (h264->ycnSurfaceProbes < YCN_H264_SURFACE_PROBE_LIMIT) ? TRUE : FALSE;
+}
+
+void ycn_h264_surface_probe_done(H264_CONTEXT* h264)
+{
+	if (!h264)
+		return;
+	if (h264->ycnSurfaceProbes < YCN_H264_SURFACE_PROBE_LIMIT)
+		h264->ycnSurfaceProbes++;
+}
+
+void ycn_h264_dispatch_surface(H264_CONTEXT* h264, const YCN_H264_SURFACE_INFO* info)
+{
+	if (!h264 || !info)
+		return;
+
+	h264->ycnSurface = *info;
+	h264->ycnSurface.size = sizeof(YCN_H264_SURFACE_INFO);
+	h264->ycnSurface.version = YCN_H264_SURFACE_API_VERSION;
+	h264->ycnSurfaceValid = TRUE;
+
+	if (g_YcnSurfaceSink)
+		g_YcnSurfaceSink(g_YcnSurfaceSinkUser, &h264->ycnSurface);
+}
+
+BOOL ycn_h264_get_surface_info(H264_CONTEXT* h264, YCN_H264_SURFACE_INFO* info)
+{
+	if (!h264 || !info)
+		return FALSE;
+	if (info->size < sizeof(*info))
+		return FALSE;
+	if (!h264->ycnSurfaceValid)
+		return FALSE;
+
+	const UINT32 size = info->size;
+	memcpy(info, &h264->ycnSurface, sizeof(*info));
+	info->size = size;
+	info->version = YCN_H264_SURFACE_API_VERSION;
+	return TRUE;
+}
+
+BOOL ycn_h264_context_recover_software(H264_CONTEXT* h264)
+{
+	if (!h264 || h264->Compressor)
+		return FALSE;
+	if (h264->ycnDecodePolicy != YCN_H264_DECODE_POLICY_AUTO_HW)
+		return FALSE;
+	if (h264->ycnRecoveryAttempts != 0)
+		return FALSE;
+	if (!h264->ycnHardwareInitialized && (h264->ycnSuccessfulHardwareFrames == 0) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_DXVA2) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_D3D11VA) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_OTHER_HW))
+		return FALSE;
+
+	h264->ycnRecoveryAttempts++;
+	if (!h264_context_set_option(h264, H264_CONTEXT_OPTION_YCN_DECODE_POLICY,
+	                             YCN_H264_DECODE_POLICY_SOFTWARE))
+		return FALSE;
+	if (!h264_context_reset(h264, h264->width, h264->height))
+		return FALSE;
+
+	/* The failed packet is intentionally not replayed: it may be a P frame
+	 * whose reference frame is unavailable after rebuilding the decoder. */
+	h264->ycnFallbackReason = YCN_H264_FALLBACK_RUNTIME_FAILED;
+	h264->ycnHardwareInitialized = FALSE;
+	h264->ycnRecoveryPending = TRUE;
+	h264->ycnActiveBackend = YCN_H264_BACKEND_UNKNOWN;
+	ycn_h264_copy_string(h264->ycnBackendName, sizeof(h264->ycnBackendName),
+	                     "software-recovering");
+	return TRUE;
+}
