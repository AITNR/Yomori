+UINT32 ycn_h264_decode_capabilities(void)
+{
+	UINT32 caps = YCN_H264_DECODE_CAP_DIAGNOSTICS;
+#ifdef WITH_GFX_H264
+	caps |= YCN_H264_DECODE_CAP_AVC;
+#endif
