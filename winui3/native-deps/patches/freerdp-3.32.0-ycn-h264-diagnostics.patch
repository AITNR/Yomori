+/* Publishes what this frame's surface actually is. Runs on the decoder thread
+ * with the frames still referenced; nothing is retained by the receiver. */
+static void ycn_h264_report_surface(H264_CONTEXT* h264, H264_CONTEXT_LIBAVCODEC* sys,
+                                    UINT64 transferTicks, UINT64 transferBytes)
+{
+	YCN_H264_SURFACE_INFO info;
+	const AVFrame* cpu = sys->videoFrame;
+	const BOOL hardware =
+	    (sys->useHwDecoder && sys->hwctx && sys->hwVideoFrame &&
+	     (sys->hwVideoFrame->format == sys->hw_pix_fmt))
+	        ? TRUE
+	        : FALSE;
+
+	memset(&info, 0, sizeof(info));
+	info.size = sizeof(info);
+	info.version = YCN_H264_SURFACE_API_VERSION;
+	info.kind = hardware ? ycn_h264_surface_kind((UINT32)sys->type) : YCN_H264_SURFACE_SOFTWARE;
+	info.hwDeviceType = hardware ? (UINT32)sys->type : (UINT32)AV_HWDEVICE_TYPE_NONE;
+	info.transferTicks = transferTicks;
+	info.transferBytes = transferBytes;
+	info.frameIndex = (UINT32)MIN(h264->ycnSuccessfulFrames, UINT32_MAX);
+	info.mapStatus = AVERROR(ENOSYS);
+
+	if (hardware)
+	{
+		const AVFrame* hw = sys->hwVideoFrame;
+		const AVHWFramesContext* frames =
+		    (hw->hw_frames_ctx ? (const AVHWFramesContext*)hw->hw_frames_ctx->data : NULL);
+
+		info.flags |= YCN_H264_SURFACE_FLAG_HW_FRAME;
+		info.frameFormat = (UINT32)hw->format;
+		info.width = (UINT32)MAX(0, hw->width);
+		info.height = (UINT32)MAX(0, hw->height);
+		info.swFormat = (UINT32)AV_PIX_FMT_NONE;
+		if (frames)
+		{
+			info.swFormat = (UINT32)frames->sw_format;
+			info.hwFramesCtx = hw->hw_frames_ctx;
+			info.deviceCtx = frames->device_ctx;
+			info.flags |= YCN_H264_SURFACE_FLAG_HAS_FRAMES_CTX;
+			ycn_h264_copy_name(info.swFormatName, sizeof(info.swFormatName),
+			                   av_get_pix_fmt_name(frames->sw_format));
+		}
+		for (size_t i = 0; i < 4; i++)
+		{
+			info.linesize[i] = (UINT32)MAX(0, hw->linesize[i]);
+			info.plane[i] = hw->data[i];
+			if (hw->data[i])
+				info.planeCount++;
+		}
+		ycn_h264_copy_name(info.formatName, sizeof(info.formatName),
+		                   av_get_pix_fmt_name((enum AVPixelFormat)hw->format));
+		ycn_h264_copy_name(info.deviceName, sizeof(info.deviceName),
+		                   av_hwdevice_get_type_name(sys->type));
+
+		/* Bounded probe: does the frame map without a copy? A D3D11 surface maps
+		 * to a texture the bridge can inspect; DXVA2 surfaces report ENOSYS here
+		 * and have to be classified by the bridge's D3D9 path instead. */
+		if (ycn_h264_surface_probe_wanted(h264))
+		{
+			AVFrame* mapped = av_frame_alloc();
+			if (mapped)
+			{
+				int status = av_hwframe_map(mapped, hw, AV_HWFRAME_MAP_READ | AV_HWFRAME_MAP_DIRECT);
+				if (status == 0)
+					info.flags |= YCN_H264_SURFACE_FLAG_MAP_READ | YCN_H264_SURFACE_FLAG_MAP_DIRECT;
+				else
+				{
+					status = av_hwframe_map(mapped, hw, AV_HWFRAME_MAP_READ);
+					if (status == 0)
+						info.flags |= YCN_H264_SURFACE_FLAG_MAP_READ;
+					info.mapStatus = status;
+				}
+				av_frame_free(&mapped);
+			}
+			ycn_h264_surface_probe_done(h264);
+		}
+	}
+	else
+	{
+		info.frameFormat = (UINT32)cpu->format;
+		info.swFormat = (UINT32)cpu->format;
+		info.width = (UINT32)MAX(0, cpu->width);
+		info.height = (UINT32)MAX(0, cpu->height);
+		for (size_t i = 0; i < 4; i++)
+			info.linesize[i] = (UINT32)MAX(0, cpu->linesize[i]);
+		ycn_h264_copy_name(info.formatName, sizeof(info.formatName),
+		                   av_get_pix_fmt_name(cpu->format));
+		ycn_h264_copy_name(info.deviceName, sizeof(info.deviceName), "ffmpeg-software");
+	}
+
+	info.cpuFormat = (UINT32)cpu->format;
+	ycn_h264_dispatch_surface(h264, &info);
+}
+#endif
