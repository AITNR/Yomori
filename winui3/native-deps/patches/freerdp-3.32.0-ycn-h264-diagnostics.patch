+	/* ---- Yomori direct-present surface probe ----
+	 * The decoder publishes a descriptor of the surface that produced the last
+	 * frame *before* it is turned into CPU pixels. The bridge inspects it and
+	 * decides whether a zero-copy GPU path is reachable for this session. This
+	 * is measurement only: nothing here changes what GDI draws. */
+#define YCN_H264_SURFACE_API_VERSION 1U
+
+#define YCN_H264_SURFACE_NONE     0U
+#define YCN_H264_SURFACE_SOFTWARE 1U
