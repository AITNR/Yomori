+static void ycn_h264_copy_string(char* dst, size_t dstSize, const char* src)
+{
+	if (!dst || (dstSize == 0))
+		return;
+	if (!src)
+		src = "";
+	strncpy(dst, src, dstSize - 1);
+	dst[dstSize - 1] = '\0';
+}
+
+static UINT32 ycn_h264_backend_from_name(const char* name, BOOL hardware)
+{
+	if (!hardware)
+		return YCN_H264_BACKEND_SOFTWARE;
+	if (!name)
+		return YCN_H264_BACKEND_OTHER_HW;
+	if (strcmp(name, "dxva2") == 0)
+		return YCN_H264_BACKEND_DXVA2;
+	if (strcmp(name, "d3d11va") == 0)
+		return YCN_H264_BACKEND_D3D11VA;
+	return YCN_H264_BACKEND_OTHER_HW;
+}
+
+void ycn_h264_diag_begin_frame(H264_CONTEXT* h264)
+{
+	if (h264)
+		h264->ycnFrameWasHardware = FALSE;
+}
+
+void ycn_h264_diag_mark_frame(H264_CONTEXT* h264, BOOL hardware, const char* backendName)
+{
+	if (!h264)
+		return;
+	h264->ycnFrameWasHardware = hardware ? TRUE : FALSE;
+	if (backendName)
+		ycn_h264_copy_string(h264->ycnBackendName, sizeof(h264->ycnBackendName), backendName);
+}
+
+void ycn_h264_diag_frame_success(H264_CONTEXT* h264)
+{
+	if (!h264)
+		return;
+	h264->ycnSuccessfulFrames++;
+	if (h264->ycnFrameWasHardware)
+	{
+		h264->ycnSuccessfulHardwareFrames++;
+		h264->ycnActiveBackend = ycn_h264_backend_from_name(h264->ycnBackendName, TRUE);
+		if (h264->ycnActiveBackend == YCN_H264_BACKEND_UNKNOWN)
+			h264->ycnActiveBackend = YCN_H264_BACKEND_OTHER_HW;
+	}
+	else
+	{
+		h264->ycnSuccessfulSoftwareFrames++;
+		h264->ycnActiveBackend = YCN_H264_BACKEND_SOFTWARE;
+	}
+	if (h264->ycnRecoveryAttempts != 0)
+		h264->ycnRecoveryPending = FALSE;
+}
+
+void ycn_h264_diag_set_error(H264_CONTEXT* h264, INT32 error, const char* phase)
+{
+	if (!h264)
+		return;
+	h264->ycnLastError = error;
+	ycn_h264_copy_string(h264->ycnLastErrorPhase, sizeof(h264->ycnLastErrorPhase), phase);
+}
+
+void ycn_h264_diag_frame_failure(H264_CONTEXT* h264, INT32 error, const char* phase)
+{
+	if (!h264)
+		return;
+	h264->ycnDecodeFailures++;
+	ycn_h264_diag_set_error(h264, error, phase);
+}
+
+void ycn_h264_diag_set_hw_initialized(H264_CONTEXT* h264, BOOL initialized,
+                                     const char* backendName)
+{
+	if (!h264)
+		return;
+	/* Device creation is only a candidate. activeBackend changes after a
+	 * successful hardware output frame. */
+	h264->ycnHardwareInitialized = initialized ? TRUE : FALSE;
+	WINPR_UNUSED(backendName);
+}
+
+void ycn_h264_diag_set_fallback(H264_CONTEXT* h264, UINT32 fallbackReason, const char* detail)
+{
+	if (!h264)
+		return;
+	if ((h264->ycnFallbackReason == YCN_H264_FALLBACK_RUNTIME_FAILED) &&
+	    (fallbackReason != YCN_H264_FALLBACK_RUNTIME_FAILED))
+		return;
+	h264->ycnFallbackReason = fallbackReason;
+	h264->ycnHardwareInitialized = FALSE;
+	WINPR_UNUSED(detail);
+}
