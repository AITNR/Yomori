+BOOL ycn_gdi_get_h264_diagnostics(rdpGdi* gdi, UINT16 surfaceId,
+                                  YCN_H264_DIAGNOSTICS* diagnostics)
+{
+	if (!gdi || !gdi->gfx || !gdi->gfx->GetSurfaceData || !diagnostics)
+		return FALSE;
+
+	BOOL rc = FALSE;
+	EnterCriticalSection(&gdi->gfx->mux);
+	gdiGfxSurface* surface = (gdiGfxSurface*)gdi->gfx->GetSurfaceData(gdi->gfx, surfaceId);
+	if (surface && surface->h264)
+		rc = ycn_h264_get_diagnostics(surface->h264, diagnostics);
+	LeaveCriticalSection(&gdi->gfx->mux);
+	return rc;
+}
