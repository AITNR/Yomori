+				return FALSE;
+			h264->ycnDecodePolicy = value;
+			if (value == YCN_H264_DECODE_POLICY_SOFTWARE)
+				h264->hwAccel = 0;
+			else if (value == YCN_H264_DECODE_POLICY_AUTO_HW)
+				h264->hwAccel = 1;
