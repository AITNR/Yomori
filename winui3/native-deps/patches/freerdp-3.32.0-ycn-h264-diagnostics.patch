+/* Offers a decoded hardware frame to the direct presenter. On success the
+ * presenter owns the AVFrame lease and the caller must not transfer it to CPU
+ * memory; on failure nothing has changed and the normal path continues. */
+static BOOL ycn_h264_try_direct(H264_CONTEXT* h264, H264_CONTEXT_LIBAVCODEC* sys)
+{
+	YCN_H264_DIRECT_FRAME info;
+	AVFrame* hold = nullptr;
+	const AVFrame* hw = nullptr;
+	const AVHWFramesContext* frames = nullptr;
+
+	if (!h264->ycnDirectArmed)
+		return FALSE;
+	if ((sys->type != AV_HWDEVICE_TYPE_D3D11VA) || !sys->hwVideoFrame)
+		return FALSE;
+
+	hw = sys->hwVideoFrame;
+	if (hw->format != sys->hw_pix_fmt)
+		return FALSE;
+
+	hold = av_frame_alloc();
+	if (!hold)
+		return FALSE;
+	if (av_frame_ref(hold, hw) < 0)
+	{
+		av_frame_free(&hold);
+		return FALSE;
+	}
+
+	memset(&info, 0, sizeof(info));
+	info.size = sizeof(info);
+	info.version = YCN_H264_DIRECT_API_VERSION;
+	info.flags = YCN_H264_DIRECT_FLAG_HW_FRAME;
+	info.width = (UINT32)MAX(0, hw->width);
+	info.height = (UINT32)MAX(0, hw->height);
+	info.hwType = (UINT32)sys->type;
+	info.pixFormat = (UINT32)hw->format;
+	info.swFormat = (UINT32)AV_PIX_FMT_NONE;
+	if (hw->hw_frames_ctx)
+	{
+		frames = (const AVHWFramesContext*)hw->hw_frames_ctx->data;
+		if (frames)
+			info.swFormat = (UINT32)frames->sw_format;
+	}
+	/* AV_PIX_FMT_D3D11 stores the subresource index in data[1]. */
+	info.subresource = (UINT32)(uintptr_t)hw->data[1];
+	info.colorMatrix = ycn_h264_color_matrix(hw->colorspace);
+	info.colorRange = ycn_h264_color_range(hw->color_range);
+	info.colorPrimaries = (UINT32)hw->color_primaries;
+	info.colorTransfer = (UINT32)hw->color_trc;
+	info.frameIndex = h264->ycnSuccessfulFrames;
+	info.pts = hw->pts;
+	info.frame = hold;
+	info.texture = hw->data[0];
+	info.device = nullptr;
+
+	if (!ycn_h264_take_direct(h264, &info))
+	{
+		av_frame_free(&hold);
+		return FALSE;
+	}
+	return TRUE;
+}
+
+/* When the bridge handed us a device, decode onto it instead of letting FFmpeg
+ * create one. A single device is what makes zero copy possible: the decoded
+ * texture, the video processor and the swap chain must all share it. */
+static int ycn_h264_create_hw_device(AVBufferRef** ctx, enum AVHWDeviceType type,
+                                     const char* name)
+{
+	void* external = ycn_h264_get_external_d3d11_device();
+
+	*ctx = nullptr;
+#if defined(_WIN32)
+	if ((type == AV_HWDEVICE_TYPE_D3D11VA) && external)
+	{
+		AVBufferRef* ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_D3D11VA);
+		if (!ref)
+			return AVERROR(ENOMEM);
+
+		AVHWDeviceContext* devctx = (AVHWDeviceContext*)ref->data;
+		AVD3D11VADeviceContext* d3dctx = (AVD3D11VADeviceContext*)devctx->hwctx;
+		d3dctx->device = (ID3D11Device*)external;
+		/* 直接走 vtable：C 里的 ID3D11Device_AddRef 宏在部分 SDK 下会被展开成
+		 * 外部符号，链接时找不到。 */
+		d3dctx->device->lpVtbl->AddRef(d3dctx->device);
+
+		const int rc = av_hwdevice_ctx_init(ref);
+		if (rc < 0)
+		{
+			av_buffer_unref(&ref);
+			return rc;
+		}
+
+		/* Refuse silently substituted devices: a mismatched device would make
+		 * every later texture hand-off invalid. */
+		if (!d3dctx->device || ((void*)d3dctx->device != external))
+		{
+			av_buffer_unref(&ref);
+			return AVERROR(EINVAL);
+		}
+
+		*ctx = ref;
+		return 0;
+	}
+#else
+	WINPR_UNUSED(external);
+#endif
+
+	return av_hwdevice_ctx_create(ctx, type, name, nullptr, 0);
+}
