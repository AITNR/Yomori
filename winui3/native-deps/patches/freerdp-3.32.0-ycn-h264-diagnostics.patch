+#define YCN_H264_COLOR_MATRIX_BT601   1U
+#define YCN_H264_COLOR_MATRIX_BT709   2U
+#define YCN_H264_COLOR_MATRIX_BT2020  3U
+
+/* ycn_h264_direct_frame.colorRange */
