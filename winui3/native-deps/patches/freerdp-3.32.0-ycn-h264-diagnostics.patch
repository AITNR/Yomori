+BOOL ycn_h264_get_diagnostics(H264_CONTEXT* h264, YCN_H264_DIAGNOSTICS* diagnostics)
+{
+	if (!h264 || !diagnostics)
+		return FALSE;
+	if ((diagnostics->size < sizeof(*diagnostics)) ||
+	    (diagnostics->version != YCN_H264_DIAGNOSTICS_VERSION))
+		return FALSE;
+
+	memset(diagnostics, 0, sizeof(*diagnostics));
+	diagnostics->size = sizeof(*diagnostics);
+	diagnostics->version = YCN_H264_DIAGNOSTICS_VERSION;
+	diagnostics->policy = h264->ycnDecodePolicy;
+	diagnostics->capabilities = ycn_h264_decode_capabilities();
+	diagnostics->hardwareRequested = h264->hwAccel ? TRUE : FALSE;
+	diagnostics->hardwareInitialized = h264->ycnHardwareInitialized;
+	diagnostics->activeBackend = h264->ycnActiveBackend;
+	diagnostics->fallbackReason = h264->ycnFallbackReason;
+	diagnostics->successfulFrames = h264->ycnSuccessfulFrames;
+	diagnostics->successfulHardwareFrames = h264->ycnSuccessfulHardwareFrames;
+	diagnostics->successfulSoftwareFrames = h264->ycnSuccessfulSoftwareFrames;
+	diagnostics->decodeFailures = h264->ycnDecodeFailures;
+	diagnostics->lastError = h264->ycnLastError;
+	diagnostics->recoveryAttempts = h264->ycnRecoveryAttempts;
+	diagnostics->recoveryPending = h264->ycnRecoveryPending;
+	ycn_h264_copy_string(diagnostics->backendName, sizeof(diagnostics->backendName),
+	                     h264->ycnBackendName);
+	ycn_h264_copy_string(diagnostics->lastErrorPhase, sizeof(diagnostics->lastErrorPhase),
+	                     h264->ycnLastErrorPhase);
+	return TRUE;
+}
