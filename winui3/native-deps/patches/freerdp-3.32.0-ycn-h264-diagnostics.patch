+/* Hands a directly presented surface back to GDI. The CPU copy of such a
+ * surface is stale by design, so only a full refresh can restore it. */
+static void ycn_gdi_drop_direct(rdpGdi* gdi, RdpgfxClientContext* context,
+                                const RDPGFX_SURFACE_COMMAND* cmd)
+{
+	if (!context || !cmd || !context->GetSurfaceData)
+		return;
+	gdiGfxSurface* surface = (gdiGfxSurface*)context->GetSurfaceData(
+	    context, (UINT16)MIN(UINT16_MAX, cmd->surfaceId));
+	if (!surface || !surface->ycnDirectActive)
+		return;
+	surface->ycnDirectActive = FALSE;
+	ycn_gdi_request_full_refresh(gdi, surface);
