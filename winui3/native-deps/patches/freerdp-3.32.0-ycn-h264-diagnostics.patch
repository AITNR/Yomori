+/* The bridge invokes this from the GFX callback on the same thread before the
+ * GDI SurfaceCommand. This is session-local because each FreeRDP session owns
+ * its event-loop thread, and avoids a process-global rdpGdi lookup table. */
+static WINPR_TLS UINT32 g_YcnThreadH264DecodePolicy = YCN_H264_DECODE_POLICY_LEGACY;
+
+BOOL ycn_gdi_set_thread_h264_decode_policy(UINT32 decodePolicy)
+{
+	if (decodePolicy > YCN_H264_DECODE_POLICY_SOFTWARE)
+		return FALSE;
+	g_YcnThreadH264DecodePolicy = decodePolicy;
+	return TRUE;
+}
+
+static UINT32 ycn_gdi_thread_h264_policy(void)
+{
+	return g_YcnThreadH264DecodePolicy;
+}
