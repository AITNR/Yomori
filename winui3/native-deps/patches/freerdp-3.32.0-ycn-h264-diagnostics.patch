+		UINT32 pixFormat;    /* AVFrame::format, e.g. AV_PIX_FMT_D3D11 */
+		UINT32 swFormat;     /* AVHWFramesContext::sw_format, e.g. AV_PIX_FMT_NV12 */
+		UINT32 subresource;  /* D3D11 subresource index of the decoded surface */
+		UINT32 colorMatrix;  /* YCN_H264_COLOR_MATRIX_* */
+		UINT32 colorRange;   /* YCN_H264_COLOR_RANGE_* */
+		UINT32 colorPrimaries; /* AVColorPrimaries of the frame */
+		UINT32 colorTransfer;  /* AVColorTransferCharacteristic of the frame */
+		UINT32 reserved0;
+		UINT64 frameIndex;
+		INT64 pts;
+		void* frame;   /* AVFrame*: owned by the receiver, see release below */
+		void* texture; /* ID3D11Texture2D*; valid while frame is held */
+		void* device;  /* ID3D11Device* of the decoder; borrowed, not AddRef'd */
+		UINT32 reserved[6];
+	} YCN_H264_DIRECT_FRAME;
