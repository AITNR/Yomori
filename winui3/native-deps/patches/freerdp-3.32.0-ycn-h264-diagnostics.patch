+UINT32 ycn_h264_decode_api_version(void)
+{
+	return YCN_H264_DECODE_API_VERSION;
+}
+
+UINT32 ycn_h264_decode_capabilities(void)
+{
+	UINT32 caps = YCN_H264_DECODE_CAP_DIAGNOSTICS;
+#ifdef WITH_GFX_H264
+	caps |= YCN_H264_DECODE_CAP_AVC;
+#endif
+#ifdef WITH_FFMPEG_HWACCEL
+	caps |= YCN_H264_DECODE_CAP_HW_COMPILED;
+#endif
+	return caps;
+}
+
+BOOL ycn_h264_get_diagnostics(H264_CONTEXT* h264, YCN_H264_DIAGNOSTICS* diagnostics)
+{
+	if (!h264 || !diagnostics)
+		return FALSE;
+	if ((diagnostics->size < sizeof(*diagnostics)) ||
+	    (diagnostics->version != YCN_H264_DIAGNOSTICS_VERSION))
+		return FALSE;
+
+	memset(diagnostics, 0, sizeof(*diagnostics));
+	diagnostics->size = sizeof(*diagnostics);
+	diagnostics->version = YCN_H264_DIAGNOSTICS_VERSION;
+	diagnostics->policy = h264->ycnDecodePolicy;
+	diagnostics->capabilities = ycn_h264_decode_capabilities();
+	diagnostics->hardwareRequested = h264->hwAccel ? TRUE : FALSE;
+	diagnostics->hardwareInitialized = h264->ycnHardwareInitialized;
+	diagnostics->activeBackend = h264->ycnActiveBackend;
+	diagnostics->fallbackReason = h264->ycnFallbackReason;
+	diagnostics->successfulFrames = h264->ycnSuccessfulFrames;
+	diagnostics->successfulHardwareFrames = h264->ycnSuccessfulHardwareFrames;
+	diagnostics->successfulSoftwareFrames = h264->ycnSuccessfulSoftwareFrames;
+	diagnostics->decodeFailures = h264->ycnDecodeFailures;
+	diagnostics->lastError = h264->ycnLastError;
+	diagnostics->recoveryAttempts = h264->ycnRecoveryAttempts;
+	diagnostics->recoveryPending = h264->ycnRecoveryPending;
+	ycn_h264_copy_string(diagnostics->backendName, sizeof(diagnostics->backendName),
+	                     h264->ycnBackendName);
+	ycn_h264_copy_string(diagnostics->lastErrorPhase, sizeof(diagnostics->lastErrorPhase),
+	                     h264->ycnLastErrorPhase);
+	return TRUE;
+}
+
+BOOL ycn_h264_context_recover_software(H264_CONTEXT* h264)
+{
+	if (!h264 || h264->Compressor)
+		return FALSE;
+	if (h264->ycnDecodePolicy != YCN_H264_DECODE_POLICY_AUTO_HW)
+		return FALSE;
+	if (h264->ycnRecoveryAttempts != 0)
+		return FALSE;
+	if (!h264->ycnHardwareInitialized && (h264->ycnSuccessfulHardwareFrames == 0) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_DXVA2) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_D3D11VA) &&
+	    (h264->ycnActiveBackend != YCN_H264_BACKEND_OTHER_HW))
+		return FALSE;
+
+	h264->ycnRecoveryAttempts++;
+	if (!h264_context_set_option(h264, H264_CONTEXT_OPTION_YCN_DECODE_POLICY,
+	                             YCN_H264_DECODE_POLICY_SOFTWARE))
+		return FALSE;
+	if (!h264_context_reset(h264, h264->width, h264->height))
+		return FALSE;
+
+	/* The failed packet is intentionally not replayed: it may be a P frame
+	 * whose reference frame is unavailable after rebuilding the decoder. */
+	h264->ycnFallbackReason = YCN_H264_FALLBACK_RUNTIME_FAILED;
+	h264->ycnHardwareInitialized = FALSE;
+	h264->ycnRecoveryPending = TRUE;
+	h264->ycnActiveBackend = YCN_H264_BACKEND_UNKNOWN;
+	ycn_h264_copy_string(h264->ycnBackendName, sizeof(h264->ycnBackendName),
+	                     "software-recovering");
+	return TRUE;
+}
