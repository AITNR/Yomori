+	/* ---- Yomori direct present ----
+	 * When a decoder is armed for direct present and the decoded frame really is
+	 * a shareable hardware surface, the frame is handed to the registered sink
+	 * *instead of* being copied to CPU pixels. The receiver keeps the AVFrame
+	 * reference (the lease) and releases it when the GPU is done with the
+	 * texture. Arming is decided per surface command by the bridge, so a frame
+	 * the receiver refuses simply takes the normal GPU->CPU path. */
+#define YCN_H264_DIRECT_API_VERSION 1U
+
+/* ycn_h264_direct_frame.flags */
+#define YCN_H264_DIRECT_FLAG_HW_FRAME   0x00000001U
+#define YCN_H264_DIRECT_FLAG_FULL_FRAME 0x00000002U
