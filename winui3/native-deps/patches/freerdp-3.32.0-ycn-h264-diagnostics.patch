+	const RECTANGLE_16 rect = { .left = 0,
+		                        .top = 0,
+		                        .right = (UINT16)MIN(UINT16_MAX, surface->width),
+		                        .bottom = (UINT16)MIN(UINT16_MAX, surface->height) };
