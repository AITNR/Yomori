+ * for a keyframe. Subsequent failures while recovery is pending are counted
+ * but do not rebuild again. */
+static BOOL ycn_gdi_handle_h264_failure(rdpGdi* gdi, gdiGfxSurface* surface)
+{
+	if (!gdi || !surface || !surface->h264)
+		return FALSE;
+
+	const BOOL recovered = ycn_h264_context_recover_software(surface->h264);
+	YCN_H264_DIAGNOSTICS diagnostics = WINPR_C_ARRAY_INIT;
+	diagnostics.size = sizeof(diagnostics);
+	diagnostics.version = YCN_H264_DIAGNOSTICS_VERSION;
+	const BOOL haveDiagnostics = ycn_h264_get_diagnostics(surface->h264, &diagnostics);
+	if (recovered)
+		ycn_gdi_request_full_refresh(gdi, surface);
+	return recovered || (haveDiagnostics && diagnostics.recoveryPending);
+}
