+/* Yomori: 恢复解码时先等关键帧。
+ *
+ * 暂停期间整帧被丢弃，解码器的 DPB 里就缺了这些参考帧。恢复后先到的 P 帧会解出
+ * 成片错误块（实测是整屏彩色斜纹），而且它又成为后续帧的参考，画面会一直烂到
+ * 下一个 IDR 才恢复。所以恢复后先只"喂"不"出"：码流照常送进解码器保持连续，
+ * 但在拿到主码流的第一个 I 帧之前，不把结果写进表面 —— 表面因此停在暂停前最后
+ * 一张好图上。
+ *
+ * 兜底：万一服务端迟迟不发 IDR（RefreshRect 不保证一定触发），丢掉
+ * YCN_WAIT_KEYFRAME_MAX_FRAMES 帧后放行。宁可短暂有块，也不能永久定格。
+ */
+#define YCN_WAIT_KEYFRAME_MAX_FRAMES 90
+
+void ycn_h264_set_wait_keyframe(H264_CONTEXT* h264, BOOL wait)
+{
+	if (!h264)
+		return;
+
+	h264->ycnWaitKeyframe = wait ? 1u : 0u;
+	h264->ycnWaitKeyframeFrames = 0;
+}
+
+static BOOL ycn_h264_skip_non_keyframe(H264_CONTEXT* h264, BOOL mainStream)
+{
+	if (!h264 || (h264->ycnWaitKeyframe == 0))
+		return FALSE;
+
+	/* 只有主码流的 I 帧才算恢复点：辅助流的 I 帧不代表主流参考链已重建。 */
+	if (mainStream && h264->ycnFrameIsKeyframe)
+	{
+		h264->ycnWaitKeyframe = 0;
+		h264->ycnWaitKeyframeFrames = 0;
+		return FALSE;
+	}
+
+	if (++h264->ycnWaitKeyframeFrames > YCN_WAIT_KEYFRAME_MAX_FRAMES)
+	{
+		h264->ycnWaitKeyframe = 0;
+		h264->ycnWaitKeyframeFrames = 0;
+		return FALSE;
+	}
+
+	return TRUE;
+}
