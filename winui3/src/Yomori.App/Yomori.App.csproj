<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Yomori</RootNamespace>
    <AssemblyName>Yomori</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 程序图标：编译期写进 exe 的 RT_GROUP_ICON。
         少了这一行，exe 里没有任何图标资源，任务栏 / 资源管理器 / Alt-Tab 全是默认空白图标
         （MainWindow 里的 AppWindow.SetIcon 只管窗口标题栏那一张，管不到 exe 自身）。
         路径相对本 csproj：src/Yomori.App → src → winui3 → repo，再进 repo\assets。
         ⚠️ 别改成 assets\icon.ico 之类：项目目录下并没有 assets\，真源在仓库根（见 package_release.py）。 -->
    <ApplicationIcon>..\..\..\assets\icon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包（unpackaged）模式：可以直接 dotnet build / 直接双击 exe 运行，不依赖 MSIX 工具链 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 版本号：CI 用 -p:Version=<版本> 传全局属性，全局属性优先级最高，
         项目文件里再赋值也不会生效 —— 所以下面这行只管本机 dotnet build 的情形，
         给「设置 → 关于」一个能认出来的版本号（-dev.local 后缀会被识别为自编译版）。 -->
    <Version Condition="'$(Version)' == '' Or '$(Version)' == '1.0.0'">2.0.0-dev.local</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS1591;NU1701</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 用自己的 Main（Program.cs）：XAML 初始化失败时也能先落日志 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 仅用于超时现场截图（全屏抓图） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- .NET 8 默认不含 GBK(936) 等代码页编码，读 netsh / cmdkey 等原生工具的 GBK 输出要靠它提供的 CodePagesEncodingProvider -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 第三方组件清单（「设置 → 关于 → 开源许可」的数据源）。
       ⚠️ 这份 JSON 是**单一数据源**：打包脚本 tools/gen_third_party_notices.py 读同一个文件
          生成 THIRD-PARTY-NOTICES.txt。改依赖只改它，别在 C# 或脚本里另抄一份清单。
       ⚠️ LogicalName 被 Services/ThirdPartyNotices.cs 硬引用（ResourceName 常量），
          改名必须两边一起改，否则界面会静默显示"清单读取失败"。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\third_party\components.json"
                      Link="ThirdParty\components.json"
                      LogicalName="Yomori.ThirdParty.components.json" />
  </ItemGroup>

  <!-- RdpNative：ycn_rdp.dll + FreeRDP 运行时（仅 x64；构建前置 = 先 build Yomori.RdpNative） -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <None Include="..\Yomori.RdpNative\build\Release\ycn_rdp.dll" Link="ycn_rdp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- UuFix：注入到 UU 服务进程的会话判定修正载荷（仅 x64；构建见 Yomori.UuFix.Native/CMakeLists.txt）
       Condition 是给本地开发用的：没先构建载荷时不要连带主控编译一起失败。
       CI 侧由 build.yml 的「构建 UU 修复载荷」步骤保证产物存在，并单独校验打包结果。 -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <None Include="..\Yomori.UuFix.Native\build\Release\uu_session_fix.dll" Link="uu_session_fix.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\Yomori.UuFix.Native\build\Release\uu_session_fix.dll')" />
  </ItemGroup>

  <Target Name="CopyRdpRuntimeDlls" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <ItemGroup>
      <RdpRuntimeDll Include="..\Yomori.RdpNative\build\Release\*.dll" Exclude="..\Yomori.RdpNative\build\Release\ycn_rdp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RdpRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- ============ 用不到的 WinAppSDK 载荷（AI / ML / Widgets）在哪裁 ============
       WindowsAppSDKSelfContained 的运行时文件来自**框架 MSIX 整包解压**
       （`obj\...\MsixContent\`，见 Microsoft.WindowsAppSDK.SelfContained.targets 的
       AddMicrosoftWindowsAppSDKPayloadFilesFromMsix），包里本就塞着 AI / ML / Widgets。
       实测过：把伞包换成 6 个子包、清空 bin 重建，onnxruntime.dll / DirectML.dll /
       Microsoft.Windows.AI.* 照样一个不少 —— 引用层面挡不住。

       ⚠️ 也别指望在本文件里加 `AfterTargets="Build"` 的 Delete 目标：那批文件是在
          AssignTargetPaths 阶段之前就挂进 None 项的，删完还会被后续拷贝再写一遍，
          实测删不掉（只剩一句误导性的"已剔除"日志）。
       所以裁剪统一放在 tools/package_release.py 的 _prune_unused()：它是发布包与安装目录的
       唯一出口，bin 目录里留着那些文件无害。清单依据：grep 全源码零引用
       Windows.AI / OnnxRuntime / DirectML / Widgets。 -->
</Project>
