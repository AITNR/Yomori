<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yomori.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 首页（2026-10-23 改版，2026-10-24 横幅改随机图库）：
         版式参考「横幅图 + 卡片区」：顶部一张通栏图（贴窗口左右边、撑满剩余高度），
         图从 assets/home_banners/ 里随机抽，每次进首页重抽，右键可换/钉死；
         图左上角叠应用名；图下方是内容区，标题行 + 四张功能入口卡。
         原来的「总览」标题 + 描述 + 状态四格换成了这张图，底部「会话通道」概览整块删除。
         2026-10-30：删掉顶部「上次运行存在需要注意的情况」InfoBar ——
         异常原因改由左侧状态面板的「异常原因」框与运行日志承担，首屏不再压一条常驻提示。 -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 横幅吃满剩余高度：卡片区之下不再留一大片空背景 -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 横幅图：贴内容区左右边、吃掉剩余高度，整块右键可换 -->
        <Grid x:Name="BannerHost" Grid.Row="0" MinHeight="160">
            <Image x:Name="BannerImage"
                   Stretch="UniformToFill"
                   Visibility="Collapsed" />

            <!-- 左上角压一层暗角，保证叠在上面的标题在任何图上都读得清 -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 图上的应用名（参考版式：标题压在横幅左上角）。
                 2026-10-24：去掉副标题，只留 Yomori。 -->
            <TextBlock Margin="36,30,0,0"
                       Text="Yomori"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="38"
                       FontWeight="SemiBold"
                       Foreground="White" />

            <!-- 图库空/图全读不出来时的占位（正常情况一进页面就会被随机图替换掉） -->
            <StackPanel x:Name="BannerPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460"
                        Spacing="8">
                <TextBlock x:Name="PlaceholderTitle"
                           Text="首页图库是空的"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PlaceholderHint"
                           Text="把 png / jpg 图片放进程序目录的 assets\home_banners 文件夹。"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>

            <!-- 有图时的小提示：不然「右键能换图」这件事没人猜得到 -->
            <Border x:Name="BannerHint"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,14,14"
                    Padding="9,4"
                    CornerRadius="4"
                    Background="#66000000"
                    Visibility="Collapsed">
                <TextBlock Text="右键换一张" FontSize="11" Foreground="White" />
            </Border>

            <Grid.ContextFlyout>
                <MenuFlyout Opening="OnBannerMenuOpening">
                    <MenuFlyoutItem x:Name="ShuffleBannerItem" Text="换一张" Click="OnShuffleBanner" />
                    <MenuFlyoutItem Text="更换图片…" Click="OnChangeBannerImage" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ClearBannerItem" Text="恢复随机展示" Click="OnRestoreRandomBanner" />
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>

        <!-- 图下方的内容区 -->
        <ScrollViewer Grid.Row="1" Padding="20,14,20,20">
            <StackPanel Spacing="12">

                <!-- 小节标题行 -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="快捷入口" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <FontIcon Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>

                <!-- 四张入口卡：只留图标 + 标题。描述文字占地方又没什么信息量，去掉后一行就够高 -->
                <Grid ColumnSpacing="10" Height="76">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Padding="16,0"
                            Style="{StaticResource OverviewCardStyle}"
                            Click="OnOpenTasks">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource YomoriAccentBrush}">
                                <FontIcon Glyph="&#xE8FD;" Foreground="White" FontSize="16" />
                            </Border>
                            <TextBlock Text="任务执行" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Padding="16,0"
                            Style="{StaticResource OverviewCardStyle}"
                            Click="OnOpenStats">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource YomoriAccentSoftBrush}">
                                <FontIcon Glyph="&#xE916;" Foreground="White" FontSize="16" />
                            </Border>
                            <TextBlock Text="运行耗时统计" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Padding="16,0"
                            Style="{StaticResource OverviewCardStyle}"
                            Click="OnOpenLogs">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource YomoriAccentSoftBrush}">
                                <FontIcon Glyph="&#xE8A5;" Foreground="White" FontSize="16" />
                            </Border>
                            <TextBlock Text="运行日志" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Padding="16,0"
                            Style="{StaticResource OverviewCardStyle}"
                            Click="OnOpenChannels">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource YomoriAccentSoftBrush}">
                                <FontIcon Glyph="&#xE713;" Foreground="White" FontSize="16" />
                            </Border>
                            <TextBlock Text="通道管理" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
