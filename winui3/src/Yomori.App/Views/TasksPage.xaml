<?xml version="1.0" encoding="utf-8"?>
<!-- 任务执行页：**按执行通道编排任务**（计划书 docs/tasks-by-channel-plan.md）。

     左：执行通道（本地执行 + 各会话通道 + 未知通道），每行右侧一个开关＝这条通道本轮要不要执行；
     中：这条通道下的任务（序号 = 通道内次序；上移/下移与抓手拖放都只在本通道内生效）；
     右：任务详情。

     注意「通道」只是**组织方式**：任务仍然只有 config.tasks 一份扁平表，靠 channel_id 归属，
     所以导入导出、执行规划（RdpChannelPlanner）都不受影响。 -->
<Page
    x:Class="Yomori.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Yomori.Helpers"
    xmlns:models="using:Yomori.Models">

    <!-- ⚠️ 别把 MenuFlyout 放进 Page.Resources 并给它 x:Name ——
         XAML 生成的 Connect() 会把具名资源的连接序号与后面控件的错位，
         构造页面时把一个 Flyout 当 Button 转型直接抛 InvalidCastException（页面进不去）。
         「移到通道…」的菜单在代码里 new 出来，见 TasksPage.xaml.cs。 -->
    <Grid Padding="16,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：执行通道 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="执行通道"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="ScopeList"
                          ItemsSource="{x:Bind VM.ChannelScopes, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnScopeSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChannelScope">
                            <Grid Padding="8,6" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 文字部分整体跟着「可用 / 不可用」变淡；开关不跟着淡，
                                     否则关掉之后它自己看着像被禁用了。 -->
                                <Grid Grid.Column="0" RowSpacing="2" ColumnSpacing="8"
                                      Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{x:Bind CountText, Mode=OneWay}"
                                               FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{x:Bind Subtitle, Mode=OneWay}"
                                               FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />

                                    <!-- 不可用原因（停用 / 未配账户 / 总开关关闭 / 未知通道）。
                                         空串时文本块高度为 0，不需要额外的 Visibility 转换。 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{x:Bind HintText, Mode=OneWay}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Grid>

                                <!-- 通道级开关：这条通道本轮要不要执行。
                                     本地执行（恒执行）与「未知通道」（配置已不存在）没有开关可拨 ——
                                     用 Visibility 收起，省下那一列的宽度。

                                     ⚠️ 2026-10-29 改：这里原来是 x:Load（+ x:Name），
                                     生成了 XamlMarkupHelper.UnloadObject() / FindName("ScopeEnabledToggle")
                                     这一对 —— 值一变就把控件从树里摘掉、模板部件释放，再靠字符串找回来。
                                     主控端在 Microsoft.UI.Xaml.dll+0x1af9d5 因空指针崩过一次，
                                     现场正是「Toggled 里改绑定属性」与「这个开关被卸载」撞在一起。
                                     现在改成纯 Visibility（静态函数绑定），控件自始至终在树上，
                                     不参与卸载/找回，也就没有这条路径。
                                     ⚠️ 别直接绑 Visibility：ChannelScope 在 Models 里，而冒烟工程
                                     把 Models 的 .cs 链进纯 .NET 工程编译，引 Microsoft.UI.Xaml 会编不过；
                                     所以走 Helpers.XamlHelpers.ToVisibility。 -->
                                <ToggleSwitch Grid.Column="1"
                                              Visibility="{x:Bind helpers:XamlHelpers.ToVisibility(CanToggle), Mode=OneWay}"
                                              IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                              OnContent="" OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Toggled="OnScopeEnabledToggled">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="这条通道本轮要不要执行：关掉后它的任务不会下发。改动即时保存，下一次「开始执行」生效；与「通道管理」页里的「启用该通道」是同一个开关。" />
                                    </ToolTipService.ToolTip>
                                </ToggleSwitch>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Button Grid.Row="2"
                    Content="通道管理"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"
                    Click="OnOpenChannels">
                <ToolTipService.ToolTip>
                    <ToolTip Content="去左侧菜单「会话通道」下的「通道管理…」增删通道、填目标账户与凭据。" />
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <!-- ===== 中：这条通道下的任务 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Button Content="添加" Click="OnAddTask"
                        IsEnabled="{x:Bind VM.CanAddTaskToScope, Mode=OneWay}" />
                <Button Content="删除" Click="OnDeleteTask" />
                <Button Content="上移" Click="OnMoveUp" />
                <Button Content="下移" Click="OnMoveDown" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ListView x:Name="TaskList"
                              ItemsSource="{x:Bind VM.ScopeTasks, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="OnSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskConfig">
                                <Grid Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 拖动抓手：按住它拖可以调整**这条通道内**的顺序。
                                         效果是「整行跟着指针走、别的行让位」——拖动中就真在
                                         集合里重排（ObservableCollection.Move），被拖的那行用
                                         TranslateTransform 追着指针走。
                                         指针全由自己接管（PointerPressed 抢 CapturePointer →
                                         PointerMoved 追指针 + 挪位 → PointerReleased 收尾），
                                         不走 WinUI 的拖放机制。
                                         ⚠️ 两次实测都拖不动，别再换回去：
                                         ① 给这里挂 CanDrag="True" 自己做 DragStarting —— 指针被
                                            ListViewItem 的按下/选择逻辑接走，子元素的拖拽手势不启动；
                                         ② 换 ListView 内置重排（CanReorderItems + ReorderMode）——
                                            在这个页面上同样按不动。
                                         所以按下时必须 e.Handled=true 抢在 ListViewItem 前面。
                                         码位 U+E76F（两条横线）已渲染核对；E700 是汉堡菜单、
                                         E784 是两条竖线（像暂停）、E9E9 是滑杆（像调参），别混用。 -->
                                    <Border Grid.Column="0"
                                            Tag="TaskGrip"
                                            Background="Transparent"
                                            Padding="2,0,4,0"
                                            VerticalAlignment="Stretch"
                                            PointerPressed="OnTaskGripPointerPressed">
                                        <FontIcon Glyph="&#xE76F;" FontSize="14" Opacity="0.45" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="按住拖动，调整这条通道内的执行顺序（只影响本通道）。" />
                                        </ToolTipService.ToolTip>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ScopeOrderText, Mode=OneWay}"
                                               Opacity="0.55"
                                               VerticalAlignment="Center"
                                               FontSize="12" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ScriptPath, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="3"
                                                  IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                  OnContent="" OffContent=""
                                                  MinWidth="0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 拖动时的落点提示线：拖动过程中**不改集合**（改了就回收容器、捕获丢失、
                     拖动当场断），所以落点只能靠这条线表达。位置由代码设 Margin.Top。 -->
                <Border x:Name="DropLine"
                        Height="2"
                        CornerRadius="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="1,0,1,0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />

                <Border x:Name="ScopeEmptyState"
                        Padding="16"
                        Visibility="Collapsed"
                        Style="{StaticResource YomoriCardStyle}">
                    <TextBlock Text="这条通道还没有任务，点「添加」新建一个吧。" Opacity="0.7" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 右：任务详情 ===== -->
        <ScrollViewer Grid.Column="2" Padding="4,0,8,0">
            <StackPanel Spacing="10">

                <TextBlock Text="任务详情" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border x:Name="OwnerBar" Padding="12,10" Style="{StaticResource YomoriCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="所属：" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind VM.ScopeOwnerText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="移到通道…" Click="OnMoveToChannelClick">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="把这条任务改派到别的通道（或本地执行），它会排到目标通道的末尾。" />
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="FormHost" Padding="16" Style="{StaticResource YomoriCardStyle}">
                    <StackPanel Spacing="14">

                        <!-- 基础 -->
                        <Expander Header="基础设置" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBox Header="游戏 / 脚本名称" Text="{Binding Name, Mode=TwoWay}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="脚本路径" Text="{Binding ScriptPath, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="浏览" VerticalAlignment="Bottom" Click="OnBrowseScript" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TimeoutBox" Grid.Column="0"
                                               Header="最大运行时间（分钟）"
                                               Minimum="0" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnTimeoutChanged" />
                                    <ComboBox x:Name="TimeoutActionBox" Grid.Column="1"
                                              Header="超时处理方式"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectionChanged="OnTimeoutActionChanged" />
                                </Grid>

                                <ToggleSwitch Header="启用命令 / 参数" IsOn="{Binding UseArgs, Mode=TwoWay}"
                                              OnContent="启用" OffContent="关闭" />

                                <!-- 启动命令 / 参数：**可写可下拉**（文本框 + 箭头 + 浮出列表）。
                                     下拉 = 该脚本已知的启动参数（Presets/launch_presets.json，识别依据是
                                     可执行文件名 + 目录里 interface.json 的 mirrorchyan_rid）；
                                     直接打字 = 自定义参数（上游随时会加新参数，所以不拦，只提示）。

                                     ⚠️ 这里试过两个"原生控件"，都栽了，别再换回去：
                                     ① `ComboBox IsEditable="True"`：Text 不随输入实时提交（只在回车 /
                                        选项变化时更新），"内部 TextBox 的 TextChanged + 失焦保存"两条路
                                        都得成立才不丢字，叠加"换 ItemsSource 清空 Text"，
                                        表现为打完字一离开就被回填空值。
                                     ② `AutoSuggestBox`：文本为空时它内部会主动把候选列表关掉，
                                        点箭头（QueryIcon）也弹不出来 ——"下拉"形同不存在。
                                     现在：TextBox 双向绑 Args（输入即落库、代码从不写 Text），
                                     箭头按钮自己 Show 一个 Flyout，列表内容与开合全在自己手里。 -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="ArgsBox" Grid.Column="0"
                                             Header="启动命令 / 参数"
                                             PlaceholderText="例如 --startOneDragon 或 daily -e；也可以直接手写"
                                             Text="{Binding Args, Mode=TwoWay}"
                                             TextChanged="OnArgsTextChanged"
                                             Loaded="OnArgsBoxLoaded" />

                                    <Button x:Name="ArgsDropButton" Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Padding="10,6"
                                            Click="OnArgsDropClick">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="从该脚本已知的启动参数里挑一条；也可以直接在左边的框里手写。" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </Grid>

                                <CheckBox x:Name="ApplyRecommendedCheck"
                                          Content="同时套用推荐设置（完成判断 / 超时 / 日志）"
                                          IsChecked="True"
                                          Checked="OnApplyRecommendedChanged"
                                          Unchecked="OnApplyRecommendedChanged">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="勾选时，选中一条启动参数会顺带写好完成判断（进程 / 窗口 / 直接等待，三选一）、最大运行时间与外部日志目录；不勾则只写参数。" />
                                    </ToolTipService.ToolTip>
                                </CheckBox>

                                <!-- 参数说明行：命中预设 = 作用 + 前置条件（灰）；未命中 = 提醒拼写（黄）。 -->
                                <TextBlock x:Name="ArgsHintText" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- 完整命令行：下拉只显示参数，看不到可执行文件，这里给一行核对用。
                                     走 CommandLine.BuildTaskCommand，与真实执行同一份拼装。 -->
                                <TextBlock x:Name="ArgsCommandText" TextWrapping="Wrap" FontSize="11" Opacity="0.55"
                                           FontFamily="Consolas" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Expander>

                        <!-- 完成判断 -->
                        <Expander Header="完成判断" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="WaitModeBox" Header="完成判断（等待模式）"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectionChanged="OnWaitModeChanged" />
                                <TextBox Header="等待关键词 / 进程名" Text="{Binding WaitProcessName, Mode=TwoWay}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="旧版兼容字段：按进程名 / 窗口标题 / 命令行关键词判断。" />
                                    </ToolTipService.ToolTip>
                                </TextBox>
                            </StackPanel>
                        </Expander>

                        <!-- 进阶：并发与守护 -->
                        <Expander Header="进阶设置（并发 / 守护 / 监控关键词）"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="ConfirmEnterBox" Grid.Column="0"
                                               Header="自动 Enter 秒"
                                               Minimum="0" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnConfirmEnterChanged" />
                                    <TextBox Grid.Column="1" Header="并发组"
                                             PlaceholderText="留空表示不并发"
                                             Text="{Binding ConcurrentGroup, Mode=TwoWay}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="同组内（相邻、同名）的任务会一起跑。**只在同一个通道内生效** —— 不同通道各跑各的，组名相同也不会并在一起。" />
                                        </ToolTipService.ToolTip>
                                    </TextBox>
                                </Grid>

                                <ComboBox x:Name="ConcurrentPolicyBox" Header="组完成策略"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectionChanged="OnConcurrentPolicyChanged" />

                                <ToggleSwitch Header="守护监控" IsOn="{Binding EnableWatchdog, Mode=TwoWay}"
                                              OnContent="开启" OffContent="关闭" />

                                <Expander Header="外部脚本实时日志"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <!-- 推荐值状态行：只读，回答"这些值哪来的、识别凭什么"。
                                             与「同时套用推荐设置」共用同一条写入路径（LaunchPresetResolver.Apply）。 -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LogProfileHint"
                                                       Grid.Column="0"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Text="选完脚本路径后，这里会显示识别出的项目与推荐日志位置" />
                                            <Button x:Name="ApplyLogPresetButton"
                                                    Grid.Column="1"
                                                    Content="套用推荐值"
                                                    IsEnabled="False"
                                                    Click="OnApplyLogPresetClick" />
                                            <Button x:Name="RestoreLogPresetButton"
                                                    Grid.Column="2"
                                                    Content="还原推荐值"
                                                    Visibility="Collapsed"
                                                    Click="OnRestoreLogPresetClick" />
                                        </Grid>

                                        <ToggleSwitch Header="启用日志跟踪"
                                                      IsOn="{Binding ExternalLogEnabled, Mode=TwoWay}"
                                                      OnContent="开启" OffContent="关闭" />

                                        <!-- 视图只决定"看什么"，不改变采集：MaaFramework 系的项目
                                             面板档是"任务开始：🤝拜访好友 / 画面检查通过"这种人话，
                                             节点档是每个节点的进出，原文档是未投影的原始行。 -->
                                        <ComboBox Header="显示视图"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding ExternalLogView, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="面板：任务与人话提示（推荐）" Tag="panel" />
                                            <ComboBoxItem Content="节点：每个节点的进出与告警" Tag="node" />
                                            <ComboBoxItem Content="原文：未处理的日志行" Tag="raw" />
                                        </ComboBox>

                                        <TextBox Header="日志文件或目录"
                                                 PlaceholderText="例如：C:\Program Files\BetterGI\log"
                                                 Text="{Binding ExternalLogPath, Mode=TwoWay}"
                                                 LostFocus="OnExternalLogFieldEdited" />

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="文件匹配模式"
                                                     PlaceholderText="目录时使用，例如 *.log"
                                                     Text="{Binding ExternalLogPattern, Mode=TwoWay}"
                                                     LostFocus="OnExternalLogFieldEdited" />
                                            <ComboBox Grid.Column="1" Header="日志编码"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding ExternalLogEncoding, Mode=TwoWay}"
                                                      SelectionChanged="OnExternalLogEncodingChanged"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="自动检测" Tag="auto" />
                                                <ComboBoxItem Content="UTF-8" Tag="utf8" />
                                                <ComboBoxItem Content="GBK / GB2312" Tag="gbk" />
                                            </ComboBox>
                                        </Grid>

                                        <ToggleSwitch Header="从文件末尾开始跟踪"
                                                      IsOn="{Binding ExternalLogFollowTail, Mode=TwoWay}"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="OnExternalLogFieldEdited">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="开启时只读取本次任务启动后新增的日志；关闭时会从文件开头读取。" />
                                            </ToolTipService.ToolTip>
                                        </ToggleSwitch>

                                        <CheckBox Content="包含子目录（递归匹配）"
                                                  IsChecked="{Binding ExternalLogRecursive, Mode=TwoWay}"
                                                  Click="OnExternalLogFieldEdited">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="只为「每次运行建一个子目录」的项目准备（例如 logs/&lt;时间戳&gt;/run.log）。默认关闭；打开后最多进 3 层、最多跟 500 个文件，超限会在日志窗口提示一次。" />
                                            </ToolTipService.ToolTip>
                                        </CheckBox>

                                        <TextBox Header="关键字（分号分隔）"
                                                 PlaceholderText="例如：error; exception; 失败"
                                                 Text="{Binding ExternalLogKeywordsText, Mode=TwoWay}"
                                                 LostFocus="OnExternalLogFieldEdited">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="用于标记日志关注点；全部新增日志均会采集，显示窗口只保留最近记录。" />
                                            </ToolTipService.ToolTip>
                                        </TextBox>
                                    </StackPanel>
                                </Expander>

                                <TextBox Header="目标进程关键词"
                                         PlaceholderText="例如：Endfield.exe; OK-WW"
                                         GotFocus="OnCleanupFieldGotFocus"
                                         LostFocus="OnCleanupFieldLostFocus"
                                         Text="{Binding ProcessKeywordsText, Mode=TwoWay}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="脚本拉起 / 等待 / 需要清理的目标程序。用于等待判断、超时清理、停止执行和紧急停止。" />
                                    </ToolTipService.ToolTip>
                                </TextBox>

                                <TextBox Header="游戏窗口关键词"
                                         PlaceholderText="例如：鸣潮; 星穹铁道"
                                         GotFocus="OnCleanupFieldGotFocus"
                                         LostFocus="OnCleanupFieldLostFocus"
                                         Text="{Binding WindowKeywordsText, Mode=TwoWay}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="游戏窗口标题里的关键词。用于窗口出现 / 消失判断；清理时会按窗口 PID 兜底关闭。" />
                                    </ToolTipService.ToolTip>
                                </TextBox>

                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="进程清理登记（可选）" Opacity="0.7" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button x:Name="CleanupFromRunButton"
                                                Content="从上次运行填入"
                                                Padding="8,2"
                                                FontSize="12"
                                                Click="OnFillCleanupFromRunClick">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="把上次运行期间新出现的进程列出来，勾选后写进「游戏进程」。远程通道由代理采集后回传，需要代理已升级。" />
                                            </ToolTipService.ToolTip>
                                        </Button>
                                        <Button x:Name="CleanupResetButton"
                                                Content="按预设重填"
                                                Padding="8,2"
                                                FontSize="12"
                                                Visibility="Collapsed"
                                                Click="OnResetCleanupClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="CleanupHint"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"
                                           FontSize="12" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="启动脚本进程"
                                             GotFocus="OnCleanupFieldGotFocus"
                                             LostFocus="OnCleanupFieldLostFocus"
                                             Text="{Binding LauncherProcess, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="主进程"
                                             GotFocus="OnCleanupFieldGotFocus"
                                             LostFocus="OnCleanupFieldLostFocus"
                                             Text="{Binding MainProcess, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Header="游戏进程"
                                             GotFocus="OnCleanupFieldGotFocus"
                                             LostFocus="OnCleanupFieldLostFocus"
                                             Text="{Binding GameProcess, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyState" Padding="16" Style="{StaticResource YomoriCardStyle}">
                    <TextBlock Text="在中间选一个任务就能编辑它；还没有任务的话，点「添加」新建一个。"
                               Opacity="0.7" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
