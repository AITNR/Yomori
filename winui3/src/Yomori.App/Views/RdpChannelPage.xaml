<?xml version="1.0" encoding="utf-8"?>
<!-- 会话通道页（计划书 §8.2 / D3；多画面已搬到 RdpMultiViewPage，见
     docs/channel-menu-multiview-plan.md）：
     左侧菜单「会话通道」下面的每一条子项对应一个本页面 —— 这里只显示**本通道**的画面、
     进度、心跳与事件；"一眼看到全部通道"是父项（会话通道）那页的事。

     布局原则：**画面优先**。画面在左侧吃满剩余高度，运行信息（运行事件 / 实时日志）
    竖排在右侧且可收起 —— 之前运行信息在画面下方、写死 174px，窗口稍矮就把画面挤成
    一条横带，而它自己也会溢出到窗口外（用户实测反馈）。 -->
<Page
    x:Class="Yomori.Views.RdpChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Yomori.Models"
    xmlns:views="using:Yomori.Views">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <!-- ===== 通道头：目标与快捷操作 ===== -->
        <Border Grid.Row="0" Padding="14,10" Style="{StaticResource YomoriCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{x:Bind ChannelName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind TargetText, Mode=OneWay}"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="连接本通道" Click="OnConnectPreviewClicked" />
                    <Button Content="打开桥目录" Click="OnOpenBridgeClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区：左边是内嵌画面，右边竖排运行信息，中间可拖动改比例 =====
             运行信息原来在画面下方、TabView 写死 174px：窗口一矮画面就被压成横带，
             它自己也溢出到窗口外（1080p 实测看不全）。改成左右分栏后，
             两栏之间的宽度由用户拖中间那条分隔条决定（宽度记进配置，下次沿用）。 -->
        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 分隔条自己占一列，宽度写死；拖动只改 EventsColumn 的宽度。 -->
                <ColumnDefinition Width="Auto" />
                <!-- 运行信息栏。收起时由代码把宽度收窄（见 OnToggleEventsClicked），
                     不设成 Auto —— TabView 里的列表会把 Auto 列撑到最宽。 -->
                <ColumnDefinition x:Name="EventsColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 画面区：本通道一格（占满整块，可全屏） -->
            <Border Grid.Column="0" Padding="0" Style="{StaticResource YomoriCardStyle}">
                <Grid>
                    <views:RdpSurfaceCell x:Name="Cell0" Margin="6" />

                    <!-- 通道不存在 / 已从配置删除时的空态 -->
                    <StackPanel x:Name="SurfaceEmptyHint"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10" MaxWidth="460"
                                Visibility="Collapsed">
                        <TextBlock x:Name="SurfaceEmptyText"
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 拖动分隔条：改两栏宽度比例（拖动逻辑在 OnSplitterPointer*，宽度记进配置）。
                 ⚠️ 必须显式给 Background="Transparent" —— Grid 没有背景时那块区域
                    **收不到指针事件**（hit test 直接穿过去），看着在但拖不动。
                 鼠标指针（↔）由 SplitterThumb 自己在构造函数里设：ProtectedCursor 是
                 protected，页面里对着普通控件改不了，只能靠子类。 -->
            <views:SplitterThumb x:Name="EventsSplitter"
                                 Grid.Column="1" Width="8"
                                 Background="Transparent"
                                 PointerPressed="OnSplitterPointerPressed"
                                 PointerMoved="OnSplitterPointerMoved"
                                 PointerReleased="OnSplitterPointerReleased"
                                 PointerCaptureLost="OnSplitterPointerReleased">
                <Rectangle Width="2" RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </views:SplitterThumb>

            <!-- 运行信息：运行事件 / 实时日志（竖排在右侧，可收起） -->
            <Border Grid.Column="2" Padding="12,8" Style="{StaticResource YomoriCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题行：栏宽只有 360，跟随开关单独占一行，别全挤在这行 -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EventsTitle" Grid.Column="0" Text="运行信息" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <HyperlinkButton x:Name="ToggleEventsButton" Grid.Column="1" Content="收起"
                                         HorizontalAlignment="Right" Click="OnToggleEventsClicked" />
                    </Grid>

                    <ToggleSwitch x:Name="FollowExternalLogsToggle" Grid.Row="1"
                                  Header="跟随日志底部" IsOn="True" MinWidth="0"
                                  OnContent="" OffContent=""
                                  Toggled="OnFollowExternalLogsChanged"
                                  ToolTipService.ToolTip="新日志到达时自动滚动到底部。关闭后可停留在历史位置查看。" />

                    <TabView x:Name="EventsTabs" Grid.Row="2"
                             IsAddTabButtonVisible="False"
                             TabWidthMode="SizeToContent"
                             SelectionChanged="OnEventsTabChanged">
                        <TabViewItem Header="运行事件" IsClosable="False">
                            <ListView x:Name="EventList"
                                      ItemsSource="{x:Bind Events, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RdpTaskEvent">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Time}" Opacity="0.55" FontSize="12" />
                                            <TextBlock Text="{x:Bind Headline}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>

                        <TabViewItem x:Name="ExternalLogsTab" Header="实时日志" IsClosable="False">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="LogLevelFilter" SelectedIndex="0"
                                              SelectionChanged="OnLogLevelChanged" MinWidth="120">
                                        <ComboBoxItem Content="全部级别" Tag="all" />
                                        <ComboBoxItem Content="警告和错误" Tag="warn" />
                                        <ComboBoxItem Content="仅错误" Tag="error" />
                                    </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="清空" HorizontalAlignment="Right"
                                            Click="OnClearExternalLogsClicked"
                                            ToolTipService.ToolTip="只清空当前显示，不影响磁盘上的日志文件" />
                                </Grid>

                                <!-- 日志跟随状态。栏宽只有 360，跟筛选行挤在一起会互相截断，
                                     所以单独占一行。 -->
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind LiveLogStatusText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind LiveLogStatusText, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" />

                                <ListView x:Name="ExternalLogList" Grid.Row="2"
                                          ItemsSource="{x:Bind ExternalLogRows, Mode=OneWay}"
                                          KeyDown="OnLogKeyDown"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="views:RdpLogRow">
                                            <StackPanel Spacing="1" Padding="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Time}" Opacity="0.55" FontSize="12" />
                                                    <TextBlock Text="{x:Bind Task}" FontSize="12"
                                                               Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Level}" Opacity="0.7" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
