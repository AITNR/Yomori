<?xml version="1.0" encoding="utf-8"?>
<!-- 通道管理 · 「新建用户」对话框（2026-11-17）。

     为什么放在这里而不是让人去 Windows 设置里点：通道要的账户有三个特殊要求 ——
     密码永不过期、默认是管理员、还要能远程登录。手动建完再回 Yomori 补这三件事，
     等于每次都要用户记住一遍。这里一次性做完，并且把"建到哪一步"如实回报。

     ⚠️ 校验不通过时用 PrimaryButtonClick 的 args.Cancel 留住对话框，
        不要在 ShowAsync 返回之后再抱怨 —— 那时输入框已经没了，用户得重填。 -->
<ContentDialog
    x:Class="Yomori.Views.CreateLocalUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新建本机用户"
    PrimaryButtonText="创建"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="380">

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="在本机创建一个 Windows 本地账户，用来做通道的目标账户。目标主机是别的机器时不要用这里 —— 那个账户要在对方计算机上建。" />

        <TextBox x:Name="NameInput"
                 Header="用户名"
                 MaxLength="20"
                 PlaceholderText="例如 Player2（本地账户名，最长 20 个字符）" />

        <PasswordBox x:Name="PasswordInput"
                     Header="密码"
                     PlaceholderText="至少 8 位；该账户会用于远程登录"
                     PasswordChar="●" />

        <PasswordBox x:Name="ConfirmInput"
                     Header="确认密码"
                     PasswordChar="●" />

        <ToggleSwitch x:Name="AdminToggle"
                      Header="设为本机管理员"
                      IsOn="True" />

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12">
            <Run Text="勾选：加入 Administrators，与「保存凭据」时的管理员授权一致（通道需要本机管理员权限）。" />
            <LineBreak />
            <Run Text="不勾选：只加入「远程桌面用户」组，账户能远程登录但没有管理员权限。" />
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                   Text="账户建好后密码默认按「设置 → 通道账户密码永不过期」的开关决定是否置「密码永不过期」；创建时会自动加入 Users 组。密码只用于创建账户，进入凭据管理器仍需在通道里点一次「保存凭据」。" />

        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{StaticResource YomoriDangerBrush}" />
    </StackPanel>
</ContentDialog>
