<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yomori.Views.OnboardingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 首次启动引导覆盖层。
         只挂在 MainWindow 根 Grid 的 Row 1（NavigationView 之上），不动标题栏拖拽区。
         层级纪律：
           ① HitLayer 的 Background 必须显式为 Transparent —— WinUI 的 Grid 空白区域
              背景为 null 时不接收指针事件，"点任意位置下一步" 会静默失效；
           ② DimCanvas / BubbleCanvas 一律 IsHitTestVisible="False"，点击穿透回 HitLayer；
           ③ 跳过按钮自己吃掉 Tapped 并置 Handled，避免冒泡成"下一步"；
           ④ 首版不做任何属性动画，规避动画专用 RenderTransform 残留导致的命中测试崩溃。 -->
    <Grid x:Name="HitLayer" Background="Transparent" Tapped="OnAdvanceTapped">

        <!-- 暗化 + EvenOdd 挖洞 + 聚焦描边 -->
        <Canvas x:Name="DimCanvas" IsHitTestVisible="False">
            <Path x:Name="DimPath" Fill="#B3000000">
                <Path.Data>
                    <GeometryGroup x:Name="DimGeometry" FillRule="EvenOdd">
                        <RectangleGeometry x:Name="FullGeometry" />
                        <RectangleGeometry x:Name="HoleGeometry" />
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <Border x:Name="FocusBorder"
                    BorderBrush="{StaticResource YomoriAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Visibility="Collapsed" />
        </Canvas>

        <!-- 气泡卡片：Canvas 绝对定位，位置由 RenderStep 按聚焦矩形算 -->
        <Canvas x:Name="BubbleCanvas" IsHitTestVisible="False">
            <Border x:Name="Bubble"
                    Style="{StaticResource YomoriCardStyle}"
                    MaxWidth="460"
                    Padding="18"
                    BorderBrush="{StaticResource YomoriAccentBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="StepTitle"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepBody"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Image x:Name="StepImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Visibility="Collapsed" />
                    <TextBlock x:Name="ImageErrorText"
                               Visibility="Collapsed"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="图片未找到，请按上方文字在 Windows 设置中添加用户。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressText" Grid.Column="0"
                                   FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Column="1"
                                   Text="点击任意位置继续"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>

        <Button x:Name="SkipButton"
                Content="跳过"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,16,0"
                Tapped="OnSkipTapped" />
    </Grid>
</UserControl>
