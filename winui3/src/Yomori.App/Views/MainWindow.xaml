<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yomori.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Yomori"
    xmlns:vm="using:Yomori.ViewModels"
    xmlns:views="using:Yomori.Views"
    xmlns:models="using:Yomori.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Grid x:Name="AppTitleBar" Height="44" Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 标题栏左侧徽标：直接用应用 logo。
                 位图在代码里加载（AssetsDir/logo.png）—— unpackaged 运行时 XAML 里的
                 ms-appx 相对路径取不到 exe 同级目录，必须走绝对路径。 -->
            <Image
                x:Name="TitleBarLogo"
                Grid.Column="0"
                Width="22" Height="22" Margin="14,0,10,0"
                Stretch="Uniform"
                AutomationProperties.Name="Yomori" />

            <TextBlock Grid.Column="1"
                       Text="Yomori"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Opacity="0.85" />
        </Grid>

        <!-- ===== 主体：NavigationView 外壳 ===== -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="196"
                        SelectionChanged="OnNavigationSelectionChanged"
                        ItemInvoked="OnNavigationItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="首页" Icon="Home" />
                <NavigationViewItem Tag="tasks" Content="任务执行" Icon="List" />
                <NavigationViewItem Tag="stats" Content="耗时统计" Icon="Clock" />
                <NavigationViewItem Tag="logs" Content="运行日志" Icon="Document" />

                <!-- 「会话通道」= 父项：点它本身只展开/收起子菜单，不导航（多画面入口在子项）；
                     它下面的子菜单才是各条通道单独的画面 + 通道管理。
                     子项由 MainWindow.RebuildChannelMenuItems() 按已配置/在跑的通道重建，
                     这里留一个「通道管理…」兜底，保证它一上来就是「带子项的父项」形态。

                     ⚠️ SelectsOnInvoked="False" 是这里的关键：不写它的话，点父项会先把
                     SelectedItem 设成父项 → SelectionChanged 拿着 tag="channels" 去 NavigateTo
                     → 被映射成「多画面」跳走，看上去和点子项「多画面」一模一样。
                     （ItemInvoked 里那句"父项只展开不导航"排在 SelectionChanged 之后，救不了。） -->
                <NavigationViewItem x:Name="ChannelsNavItem"
                                    Tag="channels"
                                    Content="会话通道"
                                    Icon="People"
                                    SelectsOnInvoked="False"
                                    IsExpanded="True">
                    <!-- 子项必须放进 MenuItems 属性元素：直接写成子元素会被当成 Content（WMC0035） -->
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Tag="channel-mgmt" Content="通道管理…" Icon="Setting" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="设置" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：运行控制栏 + 页面容器 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 运行控制栏 -->
                        <Border Grid.Row="0"
                                Padding="12,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Content="开始执行"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind VM.CanStart, Mode=OneWay}"
                                            Click="OnStartClicked" />
                                    <Button Content="暂停执行"
                                            IsEnabled="{x:Bind VM.CanPause, Mode=OneWay}"
                                            Click="OnPauseClicked" />
                                    <Button Content="继续执行"
                                            IsEnabled="{x:Bind VM.IsRunning, Mode=OneWay}"
                                            Click="OnResumeClicked" />
                                    <Button Content="停止执行  F8"
                                            IsEnabled="{x:Bind VM.CanStop, Mode=OneWay}"
                                            Click="OnStopClicked"
                                            Background="{StaticResource YomoriDangerBrush}" />
                                    <Button Content="紧急停止全部  Ctrl+Alt+F8"
                                            IsEnabled="{x:Bind VM.CanStop, Mode=OneWay}"
                                            Click="OnEmergencyStopClicked"
                                            Background="{StaticResource YomoriDangerDeepBrush}" />
                                    <Button Content="保存配置" Click="OnSaveClicked" />
                                    <Button Content="取消关机" Click="OnCancelShutdownClicked" />
                                </StackPanel>

                                <!-- 通知铃铛：有未读时点红点 + 每 2 秒轻摇一次（见 InitializeNotificationBell）。
                                     摇动动的是 RotateTransform（渲染变换），属独立动画 —— 不需要
                                     EnableDependentAnimation；只有 Width/Height 这类布局属性才需要。 -->
                                <Button x:Name="NotifyButton" Grid.Column="1"
                                        Width="34" Height="30" Padding="0"
                                        ToolTipService.ToolTip="通知">
                                    <Button.Flyout>
                                        <Flyout x:Name="NotifyFlyout" Placement="BottomEdgeAlignedRight"
                                                Opened="OnNotifyFlyoutOpened">
                                            <Grid Width="380" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="通知"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <HyperlinkButton Grid.Column="1" Content="全部已读"
                                                                     Click="OnMarkAllNotificationsRead" />
                                                    <HyperlinkButton Grid.Column="2" Content="清空"
                                                                     Click="OnClearNotifications" />
                                                </Grid>

                                                <!-- ⚠️ ItemsSource 由代码赋值（InitializeNotificationBell）：
                                                     Window 上的 x:Bind 求值早于这边的集合准备，绑了会拿到空列表。 -->
                                                <ListView x:Name="NotifyList" Grid.Row="1"
                                                          SelectionMode="None"
                                                          IsItemClickEnabled="True"
                                                          MaxHeight="360" MinHeight="72"
                                                          ItemClick="OnNotificationClicked">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AppNotification">
                                                            <Grid ColumnSpacing="8" Padding="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 这里原来有个「未读」文字标记，2026-10-26 去掉了 ——
                                                                     未读状态看铃铛上的红点就够，列表行左边不用再顶两个字。 -->
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                                    <!-- Body 必须 OneWay：下载中这行会跟着百分比刷新
                                                                         （x:Bind 默认是 OneTime，不写 Mode 就永远停在"正在连接…"）。 -->
                                                                    <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap"
                                                                               FontSize="12" Opacity="0.7" />
                                                                    <!-- 下载进度条：Progress 为 -1（没有进度可言）时 Opacity 归零，
                                                                         而不是 Visibility —— 那是 XAML 类型，Models 层不许出现，
                                                                         也省掉一个 BoolToVisibility 转换器。 -->
                                                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                                                 Maximum="100"
                                                                                 Height="3" Margin="0,2,0,0"
                                                                                 Opacity="{x:Bind ProgressOpacity, Mode=OneWay}" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{x:Bind TimeText}"
                                                                           FontSize="11" Opacity="0.55"
                                                                           VerticalAlignment="Top" />

                                                                <!-- 删除这条。Tag 绑数据项本身 —— 处理器里靠它认人，
                                                                     不依赖 DataContext 的继承（模板里两条路都能走，选稳的）。 -->
                                                                <Button Grid.Column="2"
                                                                        Click="OnDeleteNotificationClicked"
                                                                        Tag="{x:Bind}"
                                                                        Width="26" Height="26" Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="删除这条通知">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>

                                                <TextBlock x:Name="NotifyEmptyHint" Grid.Row="1"
                                                           Text="还没有通知。"
                                                           Opacity="0.6" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>

                                    <Grid>
                                        <FontIcon x:Name="NotifyIcon" Glyph="&#xEA8F;" FontSize="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform x:Name="NotifyRotate" Angle="0" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>

                                        <!-- 未读红点 -->
                                        <Border x:Name="NotifyDot"
                                                Width="8" Height="8" CornerRadius="4"
                                                Background="#E81123"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,2,3,0"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 页面容器 -->
                        <Frame x:Name="ContentFrame" Grid.Row="1" />
                    </Grid>

                    <!-- ===== 右侧执行状态栏（可收起） =====
                         宽度与展开/收起两套内容的切换全在代码里做（SetSideStatusCollapsed）：
                         XAML 里用 x:Bind 绑 bool 到 Width / Visibility 都需要转换器，不如直接设。

                         圆角只给「与内容交界」的左侧两角（8,0,0,8），右/上/下贴窗口边缘保持直角 ——
                         和左侧 NavigationView 的 pane 完全对称：那边也只有靠内容一侧的两个角是圆的
                         （实测截图：交界侧 12 物理像素 ÷ 1.5 缩放 = 8，与 OverlayCornerRadius 同值），
                         贴窗口边缘的三个角同样被窗口裁成直角。 -->
                    <Border x:Name="SideStatusPanel"
                            Grid.Column="1"
                            Width="264"
                            CornerRadius="8,0,0,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Background="{ThemeResource LayerFillColorAltBrush}">

                        <Grid>
                            <!-- 展开态 -->
                            <Grid x:Name="SideStatusExpanded">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 头部：标题 + 收起按钮 -->
                                <Grid Grid.Row="0" Margin="14,8,8,6" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="执行状态"
                                               FontSize="12"
                                               Opacity="0.7"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                            Width="28" Height="28"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnToggleSideStatus"
                                            ToolTipService.ToolTip="收起状态栏"
                                            AutomationProperties.Name="收起执行状态栏">
                                        <!-- E76C = ChevronRight。SymbolIcon 没有 FontSize，
                                             且 Symbol 枚举里没有 Chevron* —— 一律用 FontIcon。 -->
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- 状态值 + 总进度 -->
                                <StackPanel Grid.Row="1" Margin="14,0,14,10" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- 状态色点：三色各一个，代码只切 Visibility，
                                             颜色由主题资源决定，不在这里硬编码。 -->
                                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                                            <Ellipse x:Name="SideDotActive" Width="8" Height="8"
                                                     Fill="{StaticResource YomoriAccentBrush}"
                                                     Visibility="Collapsed" />
                                            <Ellipse x:Name="SideDotAbnormal" Width="8" Height="8"
                                                     Fill="{StaticResource YomoriDangerBrush}"
                                                     Visibility="Collapsed" />
                                            <Ellipse x:Name="SideDotIdle" Width="8" Height="8"
                                                     Fill="{ThemeResource TextFillColorDisabledBrush}" />
                                        </Grid>

                                        <TextBlock x:Name="SideStatusValue"
                                                   Text="空闲"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 总进度 = 本轮全部通道的完成数之和 / 总数之和 -->
                                    <ProgressBar x:Name="SideProgressBar"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 Height="6" />

                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="总进度"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="SideProgressText"
                                                       Text="0 / 0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="SideElapsedText"
                                                   Text="00:00"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- 异常原因：只写「已完成（有异常）」等于没说 —— 这里给出
                                         哪条通道 / 哪个任务 / 为什么（正文由 RefreshSideStatus 写，
                                         遵循同一套签名比对，内容不变就不动控件）。 -->
                                    <Border x:Name="SideAbnormalBox"
                                            Visibility="Collapsed"
                                            Padding="8,6"
                                            CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource YomoriDangerBrush}">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- E7BA = Warning（MDL2）。SymbolIcon 没有 FontSize，一律用 FontIcon。 -->
                                                <FontIcon Glyph="&#xE7BA;"
                                                          FontSize="12"
                                                          Foreground="{StaticResource YomoriDangerBrush}" />
                                                <TextBlock Text="异常原因"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource YomoriDangerBrush}" />
                                            </StackPanel>

                                            <TextBlock x:Name="SideAbnormalReason"
                                                       Text=""
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       MaxLines="4"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock x:Name="SideAbnormalMore"
                                                       Text=""
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 当前任务 -->
                                <StackPanel Grid.Row="2" Margin="14,0,14,10" Spacing="3">
                                    <TextBlock Text="当前任务" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="SideCurrentTask"
                                               Text="－"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 执行项目（本轮各条通道 / 本地执行组），每条各带自己的进度 -->
                                <TextBlock Grid.Row="3"
                                           Text="执行项目"
                                           Style="{StaticResource StatusLabelStyle}"
                                           Margin="14,0,14,4" />

                                <Grid Grid.Row="4">
                                    <TextBlock x:Name="SideEmptyHint"
                                               Text="尚未开始执行。"
                                               FontSize="12"
                                               Opacity="0.55"
                                               Margin="14,0,14,0"
                                               TextWrapping="Wrap" />

                                    <ScrollViewer Padding="8,0,8,8"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled"
                                                  HorizontalContentAlignment="Stretch">
                                        <ItemsControl x:Name="SideRowList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,5"
                                                            CornerRadius="4"
                                                            Visibility="{Binding Visible}">
                                                        <StackPanel Spacing="3">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Ellipse Grid.Column="0"
                                                                         Width="6" Height="6"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{StaticResource YomoriAccentBrush}"
                                                                         Visibility="{Binding ActiveDot}" />

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>

                                                            <!-- 这条通道自己的进度条 -->
                                                            <ProgressBar Value="{Binding ProgressRatio}"
                                                                         Minimum="0" Maximum="1"
                                                                         Height="3" />

                                                            <Grid>
                                                                <TextBlock Text="{Binding ProgressText}"
                                                                           FontSize="11"
                                                                           Opacity="0.6" />
                                                                <TextBlock Text="{Binding StateText}"
                                                                           FontSize="11"
                                                                           Opacity="0.6"
                                                                           HorizontalAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- 收起态：展开按钮 + 总进度数字 -->
                            <StackPanel x:Name="SideStatusCollapsed"
                                        Visibility="Collapsed"
                                        Padding="0,8,0,8"
                                        Spacing="8"
                                        HorizontalAlignment="Stretch">

                                <Button Width="26" Height="26"
                                        HorizontalAlignment="Center"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnToggleSideStatus"
                                        ToolTipService.ToolTip="展开状态栏"
                                        AutomationProperties.Name="展开执行状态栏">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>

                                <!-- 44px 的窄条放不下四个字，只用两个字 + 进度数字 -->
                                <TextBlock Text="总进度"
                                           FontSize="11"
                                           Opacity="0.6"
                                           MaxWidth="40"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <TextBlock x:Name="SideCollapsedProgressText"
                                           Text="0/0"
                                           FontSize="11"
                                           Opacity="0.75"
                                           MaxWidth="40"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
