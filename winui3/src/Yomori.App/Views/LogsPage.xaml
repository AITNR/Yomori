<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yomori.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行日志" Style="{StaticResource SubtitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="清空显示" Click="OnClear" />
            <Button Content="打开日志目录" Click="OnOpenFolder" />
            <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="12">
                <Run Text="共 " /><Run Text="{x:Bind VM.LogLines.Count, Mode=OneWay}" /><Run Text=" 行" />
            </TextBlock>
        </StackPanel>

        <!-- 开发者模式关着、且确实藏过诊断行（[embed] / [memory]）时才出现：不然用户只会看到
             "以前有的那些 D3D / 帧率 / 内存数字怎么不见了"，却找不到开关在哪儿。
             可见性由 VM.DiagnosticLogHintVisibility 算（从没写过诊断行时不显示，免得白占一行）。 -->
        <TextBlock Grid.Row="2"
                   Visibility="{x:Bind VM.DiagnosticLogHintVisibility, Mode=OneWay}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Opacity="0.6"
                   Text="带 [embed]、[memory] 标签的诊断日志已隐藏（在「设置 → 开发者」里打开开发者模式即可显示；日志文件里始终完整保留）。" />

        <Border Grid.Row="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="LogList"
                      ItemsSource="{x:Bind VM.LogLines, Mode=OneWay}"
                      SelectionMode="Single"
                      Padding="4"
                      ContainerContentChanging="OnLogItemRendering">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                   Padding="6,2" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
