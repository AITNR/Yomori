<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 会话代理专用工程：**只装代理跑得到的那条链**，不碰 WinUI / WindowsAppSDK。
         为什么单独一个工程（2026-10-23）：
         代理原先复用主控端同一个 exe，部署时把整个程序目录原样复制到
         %ProgramData%\Yomori\agent —— 单份 228MB，而代理全程不开窗、不碰 XAML，
         其中约 128MB 是 WinUI 界面栈（36MB）、WindowsAppSDK（48MB）、
         ONNX/DirectML（39MB）和安装器残留（4.4MB），一辈子用不到一次。
         代理是「每个目标账户一份、全天常驻」的东西，不能靠「反正能用」糊过去。

         WinExe：由任务计划 / 启动项无人值守拉起，绝不允许闪一个控制台窗口。
         net8.0-windows（**不带平台版本**）：带了 10.0.x 就会自动引
         Microsoft.Windows.SDK.NET 投影（23.7MB），而代理这条链一个 WinRT 类型都不碰
         —— 全项目只有 NotificationService（Windows.UI.Notifications）和
         DialogHelper（Microsoft.Windows.Storage.Pickers）需要它，两个都不在本工程里。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Yomori</RootNamespace>
    <AssemblyName>Yomori.Agent</AssemblyName>
    <!-- 代理副本的快捷方式要能显示图标：ApplicationIcon 是编译期写进 RT_GROUP_ICON 的，
         MainWindow 里那句 AppWindow.SetIcon 只服务于主控端窗口，管不到这里。 -->
    <ApplicationIcon>..\..\..\assets\icon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version Condition="'$(Version)' == '' Or '$(Version)' == '1.0.0'">2.0.0-dev.local</Version>

    <!-- ── 代理端版本号（手工维护，2026-10-30 起）─────────────────────────────
         与主程序版本号**故意解耦**：主程序的版本每次发版都变，而代理载荷大部分时候
         一个字节都没动。装个新主程序就把 73MB 代理副本重铺一遍、把正在跑的代理顶掉，
         是纯粹的浪费与风险。

         规则：
           · 只有在**改动代理载荷**（本工程、以及被它链接的 Models/Services 里代理实际
             用到的代码）时才 +1；
           · 只改主程序、代理没动 → 这个数字保持不变；
           · 安装器与部署逻辑（deploy-agent 开关）都以它作为「要不要替换代理」的唯一判据。

         ⚠️ 忘了 +1 的后果：升级安装里代理不更新，而程序侧看不出任何异常
            （新功能在代理里，却还是老代理在跑）。冒烟里有一条断言盯着这个数字存在。

         ⚠️ 不能用 $(Version) 代替：CI 传的是 2.4.1-dev.184 这种带预发布后缀的版本，
            FileVersion 只保留数字段（2.4.1.0），dev 序号丢失 —— 两个不同的 dev 构建
            会拿到同一个号，判据直接失效。 -->
    <AgentVersion>2.1.0</AgentVersion>
    <FileVersion>$(AgentVersion)</FileVersion>
    <AssemblyVersion>$(AgentVersion).0</AssemblyVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 不产出 pdb：代理是分发到目标账户的常驻进程，符号文件既没用又白占体积。
         真要排查崩溃，用同版本 CI 产物里的 pdb 配上即可。 -->
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CA1416;CS1591;NU1701</NoWarn>
  </PropertyGroup>

  <!-- 版本号写进程序集元数据（AssemblyMetadataAttribute），供 AgentVersionInfo 运行时读取。
       走元数据而不是「代码里再写一个 const」，是为了让 csproj 成为唯一来源 —— 两份数字
       迟早会漂移，而漂移的表现是「版本号没变但代理行为变了」，最难查的那种。
       主控端程序集里没有这条元数据，读出来是空串，正好用来区分「这是代理进程吗」。 -->
  <ItemGroup>
    <AssemblyMetadata Include="AgentVersion" Value="$(AgentVersion)" />
  </ItemGroup>

  <!-- 源文件复用 Yomori.App，不复制一份：代理跑的就是同一套桥协议 / 任务执行 / 日志代码，
       复制会立刻分叉。这里按「链接源码 + 排除界面文件」的方式共享，
       以后谁在 Services 里新写一个引 WinUI 的服务，本工程的编译就会红 —— 这正是我们要的提醒：
       那种文件不属于代理。 -->
  <ItemGroup>
    <Compile Include="..\Yomori.App\Models\**\*.cs" LinkBase="Models" />
    <!-- Services 按「链接 + 排除」共享，排除项分两类：

         ① 界面/渲染：代理不开窗，这些文件会拖进 WinUI、Direct3D、WindowsAppSDK。
         ② RDP 解锁的**系统修改与下载链**（2026-10-26 检查记录 P2）：
            RdpUnlockService / RdpUninstallService / RdpReleaseResolver / RdpToolDownloader /
            RdpToolRunner / RdpHiddenProcess / RdpRegistryService / RdpServiceControl /
            RdpTransactionStore / RdpToolProcessTree / RdpDiagnoseCli。

         为什么第 ② 类必须排除：代理是「每个目标账户一份、全天常驻」的进程，
         它只需要执行外部脚本，没有任何理由携带「改注册表 / 换 ServiceDll / 下载并运行 exe」
         这些能力。留在编译范围里，将来一次误引用就会把高风险动作带进常驻进程；
         而排除之后一旦有人引用，代理工程会直接 CS0246 编译失败 —— 这正是我们要的提醒。 -->
    <Compile Include="..\Yomori.App\Services\**\*.cs" LinkBase="Services"
             Exclude="..\Yomori.App\Services\NotificationService.cs;..\Yomori.App\Services\RdpD3DRenderer.cs;..\Yomori.App\Services\SingleInstance.cs;..\Yomori.App\Services\RdpUnlockService.cs;..\Yomori.App\Services\RdpUninstallService.cs;..\Yomori.App\Services\RdpReleaseResolver.cs;..\Yomori.App\Services\RdpToolDownloader.cs;..\Yomori.App\Services\RdpToolRunner.cs;..\Yomori.App\Services\RdpHiddenProcess.cs;..\Yomori.App\Services\RdpRegistryService.cs;..\Yomori.App\Services\RdpServiceControl.cs;..\Yomori.App\Services\RdpTransactionStore.cs;..\Yomori.App\Services\RdpToolProcessTree.cs;..\Yomori.App\Services\RdpDiagnoseCli.cs;..\Yomori.App\Services\ControllerSessionReturnService.cs;..\Yomori.App\Services\ControllerSessionReturnCoordinator.cs;..\Yomori.App\Services\UuSessionFixService.cs;..\Yomori.App\Services\UuSessionFixScheduler.cs" />
    <Compile Include="..\Yomori.App\Helpers\**\*.cs" LinkBase="Helpers"
             Exclude="..\Yomori.App\Helpers\DialogHelper.cs;..\Yomori.App\Helpers\WindowHelper.cs;..\Yomori.App\Helpers\XamlHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 超时现场截图（代理侧 ExecuteTimeout 分支要用） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- GBK(936) 等代码页：读 netsh / cmdkey / 旧游戏控制台的输出 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
