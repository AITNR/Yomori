# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/

# Build outputs
build/
dist/
*.spec

# 本地试跑打包脚本产生的目录（package_release.py --out）
_dist*/

# Runtime logs
logs/
*.log
assets/temp/

# Runtime stats
runtime_stats/

# 本机配置（含主机名/账户名/本机路径，绝不进版本控制）—— 模板见 config.example.json
config.json
*.broken.json

# 原生层 CMake 构建目录（build-native/ 名字不匹配上面的 build/ 规则）
build-native/

# Local configs
config.local.json
auto_script_config_local.json

# Temporary files
*.tmp
*.bak
*.swp

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# PyInstaller cache
*.manifest

# C# / WinUI 3 (winui3/)
bin/
obj/
.vs/
*.user
*.suo
*.userosscache
# 上面 *.manifest 规则会误伤 WinUI 3 工程的应用清单，这里显式放行
!winui3/src/Yomori.App/app.manifest
!winui3/src/Yomori.Watchdog/app.manifest

# Test cache
.pytest_cache/

# GitHub Actions / 本地复现 CI 的中间目录（winui3/README.md §三）
ci-build/
ci-publish/
# 代理载荷的发布输出（package_release.py --agent-dir 的输入，约 73MB）
ci-agent/
# Inno 编译器的工作副本（CI 为了改 SetupLdr 清单复制出来的那份，本机编安装包也会用）
inno-patched/
native-out/
.native-build/
.vcpkg/
.nuget/

# 运行期数据（落在程序根目录）
# notifications.json = 铃铛里的通知与已读状态；updates/ = 自动下载的安装包（几十 MB）
notifications.json
updates/

# Isolated native dependency builds
.native-work/
